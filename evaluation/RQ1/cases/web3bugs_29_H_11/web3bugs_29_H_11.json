    "event": "add"
  },
  {
    "code": "uint256 _totalSupply = totalSupply;",
    "startLine": 148,
    "endLine": 148,
    "event": "add"
  },
  {
    "code": "uint256 liquidity = balanceOf[address(this)];",
    "startLine": 149,

    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 154,
    "endLine": 154,
    "event": "add"
  },
  {
    "code": "uint256 amount0 = (liquidity * balance0) / _totalSupply;",
    "startLine": 155,
    "endLine": 155,
    "event": "add"
  },
  {
    "code": "uint256 amount1 = (liquidity * balance1) / _totalSupply;",
    "startLine": 156,
    "endLine": 156,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 157,
    "endLine": 157,
    "event": "add"
  },
  {
    "code": "_burn(address(this), liquidity);",
    "startLine": 158,
    "endLine": 158,
    "event": "add"
  },
  {
    "code": "unchecked {\n}",
    "startLine": 159,
    "endLine": 160,
    "event": "add"
  },
  {
    "code": "if (tokenOut == token1) {\n}",
    "startLine": 160,
    "endLine": 161,
    "event": "add"
  },
  {
    "code": "amount1 += _getAmountOut(amount0, _reserve0 - amount0, _reserve1 - amount1);",
    "startLine": 161,
    "endLine": 161,
    "event": "add"
  },
  {
    "code": "_transfer(token1, amount1, recipient, unwrapBento);",
    "startLine": 162,
    "endLine": 162,
    "event": "add"
  },
  {
    "code": "balance1 -= amount1;",
    "startLine": 163,
    "endLine": 163,
    "event": "add"
  },
  {
    "code": "amountOut = amount1;",
    "startLine": 164,
    "endLine": 164,
    "event": "add"
  },
  {
    "code": "amount0 = 0;",
    "startLine": 165,
    "endLine": 165,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 166,
    "endLine": 167,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "require(tokenOut == token0, \"INVALID_OUTPUT_TOKEN\");",
    "startLine": 167,
    "endLine": 167,
    "event": "add"
  },
  {
    "code": "amount0 += _getAmountOut(amount1, _reserve1 - amount1, _reserve0 - amount0);",
    "startLine": 168,
    "endLine": 168,
    "event": "add"
  },
  {
    "code": "_transfer(token0, amount0, recipient, unwrapBento);",
    "startLine": 169,
    "endLine": 169,
    "event": "add"
  },
  {
    "code": "balance0 -= amount0;",
    "startLine": 170,
    "endLine": 170,
    "event": "add"
  },
  {
    "code": "amountOut = amount0;",
    "startLine": 171,
    "endLine": 171,
    "event": "add"
  },
  {
    "code": "amount1 = 0;",
    "startLine": 172,
    "endLine": 172,
    "event": "add"
  },
  {
    "code": "_update(balance0, balance1, _reserve0, _reserve1, _blockTimestampLast);",
    "startLine": 175,
    "endLine": 175,
    "event": "add"
  },
  {
    "code": "kLast = TridentMath.sqrt(balance0 * balance1);",
    "startLine": 176,
    "endLine": 176,
    "event": "add"
  },
  {
    "code": "emit Burn(msg.sender, amount0, amount1, recipient);",
    "startLine": 177,
    "endLine": 177,
    "event": "add"
  },

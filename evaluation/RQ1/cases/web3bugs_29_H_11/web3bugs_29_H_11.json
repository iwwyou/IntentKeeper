    "startLine": 99,
    "endLine": 99,
    "event": "add"
  },
  {
    "code": "function _transfer( address token, uint256 shares, address to, bool unwrapBento ) internal {\n}",
    "startLine": 100,
    "endLine": 106,
    "event": "add"
  },
  {
    "code": "if (unwrapBento) {\n}",
    "startLine": 106,
    "endLine": 107,
    "event": "add"
  },
  {
    "code": "(bool success, ) = bento.call(abi.encodeWithSelector(0x97da6d30, token, address(this), to, 0, shares));",
    "startLine": 107,
    "endLine": 107,
    "event": "add"
  },
  {
    "code": "require(success, \"WITHDRAW_FAILED\");",
    "startLine": 108,
    "endLine": 108,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 109,
    "endLine": 110,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "(bool success, ) = bento.call(abi.encodeWithSelector(0xf18d03cc, token, address(this), to, shares));",
    "startLine": 110,
    "endLine": 110,
    "event": "add"
  },
  {
    "code": "require(success, \"TRANSFER_FAILED\");",
    "startLine": 111,
    "endLine": 111,
    "event": "add"
  },

  },
  {
    "code": "function _update( uint256 balance0, uint256 balance1, uint112 _reserve0, uint112 _reserve1, uint32 _blockTimestampLast ) internal {\n}",
    "startLine": 115,
    "endLine": 122,
    "event": "add"
  },
  {
    "code": "require(balance0 <= type(uint112).max && balance1 <= type(uint112).max, \"OVERFLOW\");",
    "startLine": 122,
    "endLine": 122,
    "event": "add"
  },
  {
    "code": "if (blockTimestampLast == 0) {\n}",
    "startLine": 123,
    "endLine": 124,
    "event": "add"
  },
  {
    "code": "reserve0 = uint112(balance0);",
    "startLine": 124,
    "endLine": 124,
    "event": "add"
  },
  {
    "code": "reserve1 = uint112(balance1);",
    "startLine": 125,
    "endLine": 125,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 126,
    "endLine": 127,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "uint32 blockTimestamp = uint32(block.timestamp % 2**32);",
    "startLine": 127,
    "endLine": 127,
    "event": "add"
  },
  {
    "code": "if (blockTimestamp != _blockTimestampLast && _reserve0 != 0 && _reserve1 != 0) {\n}",
    "startLine": 128,
    "endLine": 129,
    "event": "add"
  },
  {
    "code": "unchecked {\n}",
    "startLine": 129,
    "endLine": 130,
    "event": "add"
  },
  {
    "code": "uint32 timeElapsed = blockTimestamp - _blockTimestampLast;",
    "startLine": 130,
    "endLine": 130,
    "event": "add"
  },
  {
    "code": "uint256 price0 = (uint256(_reserve1) << PRECISION) / _reserve0;",
    "startLine": 131,
    "endLine": 131,
    "event": "add"
  },
  {
    "code": "price0CumulativeLast += price0 * timeElapsed;",
    "startLine": 132,
    "endLine": 132,
    "event": "add"
  },
  {
    "code": "uint256 price1 = (uint256(_reserve0) << PRECISION) / _reserve1;",
    "startLine": 133,
    "endLine": 133,
    "event": "add"
  },
  {
    "code": "price1CumulativeLast += price1 * timeElapsed;",
    "startLine": 134,
    "endLine": 134,
    "event": "add"
  },
  {
    "code": "reserve0 = uint112(balance0);",
    "startLine": 137,
    "endLine": 137,
    "event": "add"
  },
  {
    "code": "reserve1 = uint112(balance1);",
    "startLine": 138,
    "endLine": 138,
    "event": "add"
  },
  {
    "code": "blockTimestampLast = blockTimestamp;",
    "startLine": 139,
    "endLine": 139,
    "event": "add"
  },
  {
    "code": "emit Sync(balance0, balance1);",
    "startLine": 141,
    "endLine": 141,
    "event": "add"
  },

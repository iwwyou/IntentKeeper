    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 150,
    "endLine": 150,
    "event": "add"
  },
  {
    "code": "unchecked {\n}",
    "startLine": 151,
    "endLine": 152,
    "event": "add"
  },
  {
    "code": "_totalSupply += _mintFee(_reserve0, _reserve1, _totalSupply);",
    "startLine": 152,

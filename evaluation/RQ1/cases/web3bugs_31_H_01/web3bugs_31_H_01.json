  },
  {
    "code": "uint256 balanceOfCVX = IERC20Upgradeable(CVX).balanceOf(address(this));",
    "startLine": 78,
    "endLine": 78,
    "event": "add"
  },
  {
    "code": "uint256 balanceInLock = LOCKER.balanceOf(address(this));",
    "startLine": 79,
    "endLine": 79,
    "event": "add"
  },
  {
    "code": "uint256 totalCVXBalance = balanceOfCVX.add(balanceInLock).add(wantToCVX(balanceOfWant));",
    "startLine": 80,
    "endLine": 81,
    "event": "add"

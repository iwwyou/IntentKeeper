    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 88,
    "endLine": 88,
    "event": "add"
  },
  {
    "code": "if (newLockRatio <= currentLockRatio) {\n}",
    "startLine": 89,
    "endLine": 90,
    "event": "add"
  },
  {
    "code": "uint256 toDeposit = IERC20Upgradeable(CVX).balanceOf(address(this));",
    "startLine": 90,
    "endLine": 90,
    "event": "add"
  },
  {
    "code": "if (toDeposit > 0) {\n}",
    "startLine": 91,
    "endLine": 92,
    "event": "add"
  },
  {
    "code": "CVX_VAULT.deposit(toDeposit);",
    "startLine": 92,
    "endLine": 92,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 94,
    "endLine": 94,
    "event": "add"
  },
  {
    "code": "return;",
    "startLine": 95,
    "endLine": 95,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 97,
    "endLine": 97,
    "event": "add"
  },
  {
    "code": "uint256 cvxToLock = newLockRatio.sub(currentLockRatio);",
    "startLine": 98,
    "endLine": 98,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 99,
    "endLine": 99,
    "event": "add"
  },
  {
    "code": "uint256 maxCVX = IERC20Upgradeable(CVX).balanceOf(address(this));",
    "startLine": 100,
    "endLine": 100,
    "event": "add"
  },
  {
    "code": "if (cvxToLock > maxCVX) {\n}",
    "startLine": 101,
    "endLine": 102,
    "event": "add"
  },
  {
    "code": "LOCKER.lock(address(this), maxCVX, LOCKER.maximumBoostPayment());",
    "startLine": 102,
    "endLine": 102,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 103,
    "endLine": 104,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "LOCKER.lock(address(this), cvxToLock, LOCKER.maximumBoostPayment());",
    "startLine": 104,
    "endLine": 104,
    "event": "add"
  },
  {

  },
  {
    "code": "function wantToCVX(uint256 want_) public view returns (uint256) {\n}",
    "startLine": 55,
    "endLine": 56,
    "event": "add"
  },
  {
    "code": "uint256 bCVXToCVX = CVX_VAULT.getPricePerFullShare();",
    "startLine": 56,
    "endLine": 56,
    "event": "add"
  },
  {
    "code": "return want_.mul(bCVXToCVX).div(10**18);",
    "startLine": 57,
    "endLine": 57,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 59,
    "endLine": 59,
    "event": "add"
  },
  {
    "code": "function harvest() public whenNotPaused returns (uint256 harvested) {\n}",
    "startLine": 60,

    "event": "add"
  },
  {
    "code": "uint256 newLockRatio = totalCVXBalance.mul(toLock).div(MAX_BPS);",
    "startLine": 85,
    "endLine": 85,
    "event": "add"
  },
  {
    "code": "uint256 toWantRatio = totalCVXBalance.mul(MAX_BPS.sub(toLock)).div(MAX_BPS);",

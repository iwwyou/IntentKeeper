    "event": "add"
  },
  {
    "code": "function handleFees() private {\n}",
    "startLine": 25,
    "endLine": 26,
    "event": "add"
  },
  {
    "code": "if (lastFee == 0) {\n}",
    "startLine": 26,
    "endLine": 27,
    "event": "add"
  },
  {
    "code": "lastFee = block.timestamp;",
    "startLine": 27,
    "endLine": 27,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 28,
    "endLine": 29,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "uint256 startSupply = totalSupply();",
    "startLine": 29,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 30,
    "endLine": 30,
    "event": "add"
  },
  {
    "code": "uint256 timeDiff = (block.timestamp - lastFee);",
    "startLine": 31,
    "endLine": 31,
    "event": "add"
  },
  {
    "code": "uint256 feePct = timeDiff * licenseFee / ONE_YEAR;",
    "startLine": 32,
    "endLine": 32,
    "event": "add"
  },
  {
    "code": "uint256 fee = startSupply * feePct / (BASE - feePct);",
    "startLine": 33,
    "endLine": 33,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 34,
    "endLine": 34,
    "event": "add"
  },
  {
    "code": "_mint(publisher, fee * (BASE - factory.ownerSplit()) / BASE);",
    "startLine": 35,
    "endLine": 35,
    "event": "add"
  },
  {
    "code": "_mint(Ownable(address(factory)).owner(), fee * factory.ownerSplit() / BASE);",
    "startLine": 36,
    "endLine": 36,
    "event": "add"
  },
  {
    "code": "lastFee = block.timestamp;",
    "startLine": 37,
    "endLine": 37,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 38,
    "endLine": 38,
    "event": "add"
  },
  {
    "code": "uint256 newIbRatio = ibRatio * startSupply / totalSupply();",
    "startLine": 39,
    "endLine": 39,
    "event": "add"
  },
  {
    "code": "ibRatio = newIbRatio;",
    "startLine": 40,
    "endLine": 40,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 41,
    "endLine": 41,
    "event": "add"
  },
  {
    "code": "emit NewIBRatio(ibRatio);",
    "startLine": 42,
    "endLine": 42,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 45,
    "endLine": 45,
    "event": "add"
  },
  {
    "code": "function auctionBurn(uint256 amount) onlyAuction external {\n}",
    "startLine": 46,
    "endLine": 47,
    "event": "add"
  },
  {
    "code": "handleFees();",
    "startLine": 47,
    "endLine": 47,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 48,
    "endLine": 48,
    "event": "add"
  },
  {
    "code": "_burn(msg.sender, amount);",
    "startLine": 49,
    "endLine": 49,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 50,
    "endLine": 50,
    "event": "add"
  },
  {
    "code": "emit Burned(msg.sender, amount);",
    "startLine": 51,
    "endLine": 51,
    "event": "add"
  },

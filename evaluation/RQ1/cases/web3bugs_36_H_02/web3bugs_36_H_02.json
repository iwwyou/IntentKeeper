  },
  {
    "code": "\n",
    "startLine": 14,
    "endLine": 14,
    "event": "add"
  },
  {
    "code": "uint256 public lastFee;",
    "startLine": 15,
    "endLine": 15,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 16,
    "endLine": 16,
    "event": "add"
  },
  {
    "code": "event NewIBRatio(uint256 ibRatio);",
    "startLine": 17,
    "endLine": 17,
    "event": "add"
  },
  {
    "code": "event Burned(address indexed _from, uint256 _amount);",
    "startLine": 18,
    "endLine": 18,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 19,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "modifier onlyAuction() {\n}",
    "startLine": 20,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "require(msg.sender == address(auction));",
    "startLine": 21,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "_;",
    "startLine": 22,
    "endLine": 22,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 24,

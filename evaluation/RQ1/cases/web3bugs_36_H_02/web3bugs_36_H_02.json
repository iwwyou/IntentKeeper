    "startLine": 4,
    "endLine": 4,
    "event": "add"
  },
  {
    "code": "uint256 private constant BASE = 1e18;",
    "startLine": 5,
    "endLine": 5,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 6,
    "endLine": 6,
    "event": "add"
  },
  {
    "code": "address public publisher;",
    "startLine": 7,
    "endLine": 7,
    "event": "add"
  },
  {

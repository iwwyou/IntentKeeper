  {
    "code": "function _getTargetPricePrecise(TargetPrice storage self) internal view returns (uint256) {\n}",
    "startLine": 80,
    "endLine": 81,
    "event": "add"
  },
  {
    "code": "uint256 t1 = self.futureTargetPriceTime;",
    "startLine": 81,
    "endLine": 81,
    "event": "add"
  },
  {
    "code": "uint256 a1 = self.futureTargetPrice;",
    "startLine": 82,
    "endLine": 82,
    "event": "add"
  },
  {
    "code": "uint256 newTargetPrice;",
    "startLine": 83,
    "endLine": 83,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 84,
    "endLine": 84,
    "event": "add"
  },
  {
    "code": "if (block.timestamp < t1) {\n}",
    "startLine": 85,
    "endLine": 86,
    "event": "add"
  },
  {
    "code": "uint256 t0 = self.initialTargetPriceTime;",
    "startLine": 86,
    "endLine": 86,
    "event": "add"
  },
  {
    "code": "uint256 a0 = self.initialTargetPrice;",
    "startLine": 87,
    "endLine": 87,
    "event": "add"
  },
  {
    "code": "if (a1 > a0) {\n}",
    "startLine": 88,
    "endLine": 89,
    "event": "add"
  },
  {
    "code": "newTargetPrice = a0.add(a1.sub(a0).mul(block.timestamp.sub(t0)).div(t1.sub(t0)));",
    "startLine": 89,
    "endLine": 89,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 90,
    "endLine": 91,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "newTargetPrice = a0.sub(a0.sub(a1).mul(block.timestamp.sub(t0)).div(t1.sub(t0)));",
    "startLine": 91,
    "endLine": 91,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 93,
    "endLine": 94,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "newTargetPrice = a1;",
    "startLine": 94,
    "endLine": 94,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 96,
    "endLine": 96,
    "event": "add"
  },
  {
    "code": "return newTargetPrice;",
    "startLine": 97,
    "endLine": 97,
    "event": "add"
  },

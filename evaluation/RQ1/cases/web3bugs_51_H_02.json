  {
    "code": "function rampTargetPrice( TargetPrice storage self, uint256 futureTargetPrice_, uint256 futureTime_ ) external returns (uint256) {\n}",
    "startLine": 100,
    "endLine": 105,
    "event": "add"
  },
  {
    "code": "// @GlobalVar block.timestamp = [2000000, 2000000]",
    "startLine": 105,
    "endLine": 105,
    "event": "add"
  },
  {
    "code": "// @StateVar self.initialTargetPriceTime = [1000000, 1000000]",
    "startLine": 106,
    "endLine": 106,
    "event": "add"
  },
  {
    "code": "// @StateVar self.futureTargetPriceTime = [1500000, 1500000]",
    "startLine": 107,
    "endLine": 107,
    "event": "add"
  },
  {
    "code": "// @StateVar self.futureTargetPrice = [1000000000000000000, 1000000000000000000]",
    "startLine": 108,
    "endLine": 108,
    "event": "add"
  },
  {
    "code": "// @StateVar self.initialTargetPrice = [1000000000000000000, 1000000000000000000]",
    "startLine": 109,
    "endLine": 109,
    "event": "add"
  },
  {
    "code": "// @StateVar self.originalPrecisionMultipliers[0] = [1000000000000000000, 1000000000000000000]",
    "startLine": 110,
    "endLine": 110,
    "event": "add"
  },
  {
    "code": "// @LocalVar futureTargetPrice_ = [990000000000000000, 990000000000000000]",
    "startLine": 111,
    "endLine": 111,
    "event": "add"
  },
  {
    "code": "// @LocalVar futureTime_ = [3209600, 3209600]",
    "startLine": 112,
    "endLine": 112,
    "event": "add"
  },
  {
    "code": "require(block.timestamp >= self.initialTargetPriceTime.add(1 days), \"Wait 1 day before starting ramp\");",
    "startLine": 113,
    "endLine": 113,
    "event": "add"
  },
  {
    "code": "require(futureTime_ >= block.timestamp.add(MIN_RAMP_TIME), \"Insufficient ramp time\");",
    "startLine": 114,
    "endLine": 114,
    "event": "add"
  },
  {
    "code": "require(futureTargetPrice_ >= 0, \"futureTargetPrice_ must be >= 0\");",
    "startLine": 115,
    "endLine": 115,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 116,
    "endLine": 116,
    "event": "add"
  },
  {
    "code": "uint256 initialTargetPricePrecise = _getTargetPricePrecise(self);",
    "startLine": 117,
    "endLine": 117,
    "event": "add"
  },
  {
    "code": "uint256 futureTargetPricePrecise = futureTargetPrice_.mul(TARGET_PRICE_PRECISION);",
    "startLine": 118,
    "endLine": 118,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 119,
    "endLine": 119,
    "event": "add"
  },
  {
    "code": "if (futureTargetPricePrecise < initialTargetPricePrecise) {\n}",
    "startLine": 120,
    "endLine": 121,
    "event": "add"
  },
  {
    "code": "// @During require feasible",
    "startLine": 121,
    "endLine": 121,
    "event": "add"
  },
  {
    "code": "require(futureTargetPricePrecise.mul(MAX_RELATIVE_PRICE_CHANGE).div(WEI_UNIT) >= initialTargetPricePrecise, \"futureTargetPrice_ is too small\");",
    "startLine": 122,
    "endLine": 122,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 123,
    "endLine": 124,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "require(futureTargetPricePrecise <= initialTargetPricePrecise.mul(MAX_RELATIVE_PRICE_CHANGE).div(WEI_UNIT), \"futureTargetPrice_ is too large\");",
    "startLine": 124,
    "endLine": 124,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 126,
    "endLine": 126,
    "event": "add"
  },
  {
    "code": "self.initialTargetPrice = initialTargetPricePrecise;",
    "startLine": 127,
    "endLine": 127,
    "event": "add"
  },
  {
    "code": "self.futureTargetPrice = futureTargetPricePrecise;",
    "startLine": 128,
    "endLine": 128,
    "event": "add"
  },
  {
    "code": "self.initialTargetPriceTime = block.timestamp;",
    "startLine": 129,
    "endLine": 129,
    "event": "add"
  },
  {
    "code": "self.futureTargetPriceTime = futureTime_;",
    "startLine": 130,
    "endLine": 130,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 131,
    "endLine": 131,
    "event": "add"
  },
  {
    "code": "return self.originalPrecisionMultipliers[0].mul(initialTargetPricePrecise).div(WEI_UNIT);",
    "startLine": 132,
    "endLine": 132,
    "event": "add"
  }
]

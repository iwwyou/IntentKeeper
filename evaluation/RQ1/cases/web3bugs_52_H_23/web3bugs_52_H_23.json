  },
  {
    "code": "function mintSynth( IERC20 foreignAsset, uint256 nativeDeposit, address _from, address to ) external supportedToken(foreignAsset) returns (uint256 amountSynth) {\n}",
    "startLine": 86,
    "endLine": 96,
    "event": "add"
  },
  {
    "code": "nativeAsset.safeTransferFrom(_from, address(this), nativeDeposit);",
    "startLine": 96,
    "endLine": 96,

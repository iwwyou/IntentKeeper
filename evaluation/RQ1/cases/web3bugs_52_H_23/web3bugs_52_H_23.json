  },
  {
    "code": "\n",
    "startLine": 97,
    "endLine": 97,
    "event": "add"
  },
  {
    "code": "ISynth synth = synthFactory.synths(foreignAsset);",
    "startLine": 98,
    "endLine": 98,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 99,
    "endLine": 99,
    "event": "add"
  },
  {
    "code": "if (synth == ISynth(address(0))) {\n}",
    "startLine": 100,
    "endLine": 101,
    "event": "add"
  },
  {
    "code": "synth = synthFactory.createSynth(IERC20Extended(address(foreignAsset)));",
    "startLine": 101,
    "endLine": 101,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 103,
    "endLine": 103,
    "event": "add"
  },
  {
    "code": "(uint112 reserveNative, uint112 reserveForeign, ) = getReserves( foreignAsset );",
    "startLine": 104,
    "endLine": 106,

  },
  {
    "code": "function _update( IERC20 foreignAsset, uint256 balanceNative, uint256 balanceForeign, uint112 reserveNative, uint112 reserveForeign ) internal {\n}",
    "startLine": 51,
    "endLine": 58,
    "event": "add"
  },
  {
    "code": "require( balanceNative <= type(uint112).max && balanceForeign <= type(uint112).max, \"BasePoolV2::_update: Balance Overflow\" );",
    "startLine": 58,
    "endLine": 62,
    "event": "add"
  },
  {
    "code": "uint32 blockTimestamp = uint32(block.timestamp % 2**32);",
    "startLine": 63,
    "endLine": 63,
    "event": "add"
  },
  {
    "code": "PairInfo storage pair = pairInfo[foreignAsset];",
    "startLine": 64,
    "endLine": 64,
    "event": "add"
  },
  {
    "code": "unchecked {\n}",
    "startLine": 65,
    "endLine": 66,
    "event": "add"
  },
  {
    "code": "uint32 timeElapsed = blockTimestamp - pair.blockTimestampLast;",
    "startLine": 66,
    "endLine": 66,
    "event": "add"
  },
  {
    "code": "if (timeElapsed > 0 && reserveNative != 0 && reserveForeign != 0) {\n}",
    "startLine": 67,
    "endLine": 68,
    "event": "add"
  },
  {
    "code": "pair.priceCumulative.nativeLast += uint256( UQ112x112.encode(reserveForeign).uqdiv(reserveNative) ) * timeElapsed;",
    "startLine": 68,
    "endLine": 72,
    "event": "add"
  },
  {
    "code": "pair.priceCumulative.foreignLast += uint256( UQ112x112.encode(reserveNative).uqdiv(reserveForeign) ) * timeElapsed;",
    "startLine": 73,
    "endLine": 77,
    "event": "add"
  },
  {
    "code": "pair.reserveNative = uint112(balanceNative);",
    "startLine": 80,
    "endLine": 80,
    "event": "add"
  },
  {
    "code": "pair.reserveForeign = uint112(balanceForeign);",
    "startLine": 81,
    "endLine": 81,
    "event": "add"
  },
  {
    "code": "pair.blockTimestampLast = blockTimestamp;",
    "startLine": 82,
    "endLine": 82,
    "event": "add"
  },
  {
    "code": "emit Sync(foreignAsset, balanceNative, balanceForeign);",
    "startLine": 83,
    "endLine": 83,
    "event": "add"
  },

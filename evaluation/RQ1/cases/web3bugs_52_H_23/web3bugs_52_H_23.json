  {
    "code": "function getReserves(IERC20 foreignAsset) public view returns ( uint112 reserveNative, uint112 reserveForeign, uint32 blockTimestampLast ) {\n}",
    "startLine": 34,
    "endLine": 43,
    "event": "add"
  },
  {
    "code": "PairInfo storage pair = pairInfo[foreignAsset];",
    "startLine": 43,
    "endLine": 43,
    "event": "add"
  },
  {
    "code": "(reserveNative, reserveForeign, blockTimestampLast) = ( pair.reserveNative, pair.reserveForeign, pair.blockTimestampLast );",
    "startLine": 44,
    "endLine": 48,

  {
    "code": "function latestAnswer() external view returns (uint256) {\n}",
    "startLine": 7,
    "endLine": 8,
    "event": "add"
  },
  {
    "code": "uint256 gasPrice = uint256(gasOracle.latestAnswer());",
    "startLine": 8,
    "endLine": 8,
    "event": "add"
  },
  {
    "code": "uint256 ethPrice = uint256(priceOracle.latestAnswer());",
    "startLine": 9,
    "endLine": 9,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 10,
    "endLine": 10,
    "event": "add"
  },
  {
    "code": "uint256 result = PRBMathUD60x18.mul(gasPrice, ethPrice);",
    "startLine": 11,
    "endLine": 11,
    "event": "add"
  },
  {
    "code": "return result;",
    "startLine": 12,
    "endLine": 12,
    "event": "add"
  },

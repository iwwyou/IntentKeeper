    "event": "add"
  },
  {
    "code": "uint256 buyingSpeed;",
    "startLine": 13,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "uint256 withdrawingSpeed;",
    "startLine": 14,
    "endLine": 14,
    "event": "add"
  },
  {
    "code": "uint256 lastBought;",
    "startLine": 15,
    "endLine": 15,
    "event": "add"
  },
  {
    "code": "uint256 lastWithdrawn;",
    "startLine": 16,
    "endLine": 16,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 18,
    "endLine": 18,
    "event": "add"
  },
  {
    "code": "mapping(address => HourlyBondMetadata) hourlyBondMetadata;",
    "startLine": 19,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 20,
    "endLine": 20,
    "event": "add"
  },
  {
    "code": "mapping(address => mapping(address => HourlyBond)) public hourlyBondAccounts;",
    "startLine": 21,
    "endLine": 22,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 23,
    "endLine": 23,
    "event": "add"
  },
  {
    "code": "function calcCumulativeYieldFP( YieldAccumulator storage yieldAccumulator, uint256 timeDelta ) internal view returns (uint256 accumulatorFP) {\n}",
    "startLine": 24,
    "endLine": 28,
    "event": "add"
  },
  {
    "code": "uint256 secondsDelta = timeDelta % (1 hours);",
    "startLine": 28,
    "endLine": 28,
    "event": "add"
  },
  {
    "code": "accumulatorFP = (yieldAccumulator.accumulatorFP * yieldAccumulator.hourlyYieldFP * secondsDelta) / (FP32 * 1 hours);",
    "startLine": 29,
    "endLine": 33,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 34,
    "endLine": 34,
    "event": "add"
  },
  {
    "code": "uint256 hoursDelta = timeDelta / (1 hours);",
    "startLine": 35,
    "endLine": 35,
    "event": "add"
  },
  {
    "code": "if (hoursDelta > 0) {\n}",
    "startLine": 36,
    "endLine": 37,
    "event": "add"
  },
  {
    "code": "for (uint256 i = 0; hoursDelta > i; i++) {\n}",
    "startLine": 37,
    "endLine": 38,
    "event": "add"
  },
  {
    "code": "accumulatorFP = (accumulatorFP * yieldAccumulator.hourlyYieldFP) / FP32;",
    "startLine": 38,
    "endLine": 40,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 44,
    "endLine": 44,
    "event": "add"
  },
  {
    "code": "function viewCumulativeYieldFP( YieldAccumulator storage yA, uint256 timestamp ) internal view returns (uint256) {\n}",
    "startLine": 45,
    "endLine": 49,
    "event": "add"
  },
  {
    "code": "uint256 timeDelta = (timestamp - yA.lastUpdated);",
    "startLine": 49,
    "endLine": 49,
    "event": "add"
  },
  {
    "code": "return calcCumulativeYieldFP(yA, timeDelta);",
    "startLine": 50,
    "endLine": 50,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 52,
    "endLine": 52,
    "event": "add"
  },
  {
    "code": "function viewHourlyBondAmount(address issuer, address holder) public view returns (uint256) {\n}",
    "startLine": 53,
    "endLine": 58,
    "event": "add"
  },
  {
    "code": "HourlyBond storage bond = hourlyBondAccounts[issuer][holder];",
    "startLine": 58,
    "endLine": 58,
    "event": "add"
  },
  {
    "code": "uint256 yieldQuotientFP = bond.yieldQuotientFP;",
    "startLine": 59,
    "endLine": 59,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 60,
    "endLine": 60,
    "event": "add"
  },
  {
    "code": "uint256 cumulativeYield = viewCumulativeYieldFP( hourlyBondMetadata[issuer].yieldAccumulator, block.timestamp );",
    "startLine": 61,
    "endLine": 65,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 66,
    "endLine": 66,
    "event": "add"
  },
  {
    "code": "if (yieldQuotientFP > 0) {\n}",
    "startLine": 67,
    "endLine": 68,
    "event": "add"
  },
  {
    "code": "return bond.amount + applyInterest(bond.amount, cumulativeYield, yieldQuotientFP);",
    "startLine": 68,
    "endLine": 70,
    "event": "add"
  },
  {
    "code": "// @Post returnExpression == (bond.amount * cumulativeYield) / yieldQuotientFP",
    "startLine": 71,
    "endLine": 71,
    "event": "add"
  },
  {
    "code": "return bond.amount + 0;",
    "startLine": 73,
    "endLine": 73,
    "event": "add"
  },

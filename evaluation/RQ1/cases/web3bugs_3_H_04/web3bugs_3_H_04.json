    "startLine": 7,
    "endLine": 7,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 9,
    "endLine": 9,
    "event": "add"
  },
  {
    "code": "abstract contract HourlyBondSubscriptionLending is BaseLending {\n}",
    "startLine": 10,
    "endLine": 11,
    "event": "add"
  },
  {
    "code": "struct HourlyBondMetadata {\n}",
    "startLine": 11,
    "endLine": 12,

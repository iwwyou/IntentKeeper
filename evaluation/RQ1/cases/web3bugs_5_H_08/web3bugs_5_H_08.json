  {
    "code": "function getSlipAdustment(uint b, uint B, uint t, uint T) public view returns (uint){\n}",
    "startLine": 17,
    "endLine": 18,
    "event": "add"
  },
  {
    "code": "uint part1 = B * t;",
    "startLine": 18,
    "endLine": 18,
    "event": "add"
  },
  {
    "code": "uint part2 = b * T;",
    "startLine": 19,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "uint part3 = (b * 2) + B;",
    "startLine": 20,
    "endLine": 20,
    "event": "add"
  },
  {
    "code": "uint part4 = t + T;",
    "startLine": 21,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "uint numerator;",
    "startLine": 22,
    "endLine": 22,
    "event": "add"
  },
  {
    "code": "if(part1 > part2){\n}",
    "startLine": 23,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "numerator = (part1 - part2);",
    "startLine": 24,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 25,
    "endLine": 26,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "numerator = (part2 - part1);",
    "startLine": 26,
    "endLine": 26,
    "event": "add"
  },
  {
    "code": "uint denominator = (part3 * part4);",
    "startLine": 28,
    "endLine": 28,
    "event": "add"
  },
  {
    "code": "return one - (numerator * one) / denominator;",
    "startLine": 29,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 31,
    "endLine": 31,
    "event": "add"
  },
  {
    "code": "function calcLiquidityUnits(uint b, uint B, uint t, uint T, uint P) external view returns (uint){\n}",
    "startLine": 32,
    "endLine": 33,
    "event": "add"
  },
  {
    "code": "if(P == 0){\n}",
    "startLine": 33,
    "endLine": 34,
    "event": "add"
  },
  {
    "code": "return b;",
    "startLine": 34,
    "endLine": 34,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 35,
    "endLine": 36,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "uint slipAdjustment = getSlipAdustment(b, B, t, T);",
    "startLine": 36,
    "endLine": 36,
    "event": "add"
  },
  {
    "code": "uint part1 = (t * B);",
    "startLine": 37,
    "endLine": 37,
    "event": "add"
  },
  {
    "code": "uint part2 = (T * b);",
    "startLine": 38,
    "endLine": 38,
    "event": "add"
  },
  {
    "code": "uint part3 = (T * B) * 2;",
    "startLine": 39,
    "endLine": 39,
    "event": "add"
  },
  {
    "code": "uint _units = (((P * part1) + part2) / part3);",
    "startLine": 40,
    "endLine": 40,
    "event": "add"
  },
  {
    "code": "return (_units * slipAdjustment) / one;",
    "startLine": 41,
    "endLine": 41,
    "event": "add"
  },
  {

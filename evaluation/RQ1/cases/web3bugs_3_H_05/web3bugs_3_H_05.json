  {
    "code": "function yieldTokenInPeg( address token, uint256 amount, mapping(address => uint256) storage yieldQuotientsFP, bool forceCurBlock ) internal returns (uint256) {\n}",
    "startLine": 22,
    "endLine": 28,
    "event": "add"
  },
  {
    "code": "uint256 yieldFP = ILending(lending()).viewBorrowingYieldFP(token);",
    "startLine": 28,
    "endLine": 28,
    "event": "add"
  },
  {
    "code": "uint256 amountInToken = (amount * yieldFP) / yieldQuotientsFP[token];",
    "startLine": 29,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "return PriceAware.getCurrentPriceInPeg( token, amountInToken, forceCurBlock );",

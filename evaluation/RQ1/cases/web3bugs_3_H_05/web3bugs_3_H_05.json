  {
    "code": "function belowMaintenanceThreshold(CrossMarginAccount storage account) internal returns (bool) {\n}",
    "startLine": 97,
    "endLine": 101,
    "event": "add"
  },
  {
    "code": "uint256 loan = loanInPeg(account, true);",
    "startLine": 101,
    "endLine": 101,
    "event": "add"
  },
  {
    "code": "uint256 holdings = holdingsInPeg(account, true);",
    "startLine": 102,
    "endLine": 102,
    "event": "add"
  },
  {
    "code": "return 100 * holdings >= liquidationThresholdPercent * loan;",

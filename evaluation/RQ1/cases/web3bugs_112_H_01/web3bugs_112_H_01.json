  },
  {
    "code": "\n",
    "startLine": 5,
    "endLine": 5,
    "event": "add"
  },
  {
    "code": "IController public immutable controller;",
    "startLine": 6,
    "endLine": 6,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 7,
    "endLine": 7,
    "event": "add"
  },
  {
    "code": "address public token;",
    "startLine": 8,
    "endLine": 8,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 9,
    "endLine": 9,
    "event": "add"
  },
  {
    "code": "mapping(address => uint256) public balances;",
    "startLine": 10,
    "endLine": 10,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 11,
    "endLine": 11,
    "event": "add"
  },
  {
    "code": "function transfer(address account, uint256 amount) external override notPaused returns (bool) {\n}",
    "startLine": 12,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "require(msg.sender != account, Error.SELF_TRANSFER_NOT_ALLOWED);",
    "startLine": 13,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "require(balances[msg.sender] >= amount, Error.INSUFFICIENT_BALANCE);",
    "startLine": 14,
    "endLine": 14,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 15,
    "endLine": 15,
    "event": "add"
  },
  {
    "code": "ILiquidityPool pool = controller.addressProvider().getPoolForToken(token);",
    "startLine": 16,
    "endLine": 16,
    "event": "add"
  },
  {
    "code": "pool.handleLpTokenTransfer(msg.sender, account, amount);",
    "startLine": 17,
    "endLine": 17,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 18,
    "endLine": 18,
    "event": "add"
  },
  {
    "code": "balances[msg.sender] -= amount;",
    "startLine": 19,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "balances[account] += amount;",
    "startLine": 20,
    "endLine": 20,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 21,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "address lpGauge = currentAddresses[_LP_GAUGE];",
    "startLine": 22,
    "endLine": 22,
    "event": "add"
  },
  {
    "code": "if (lpGauge != address(0)) {\n}",
    "startLine": 23,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "ILpGauge(lpGauge).userCheckpoint(msg.sender);",
    "startLine": 24,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "ILpGauge(lpGauge).userCheckpoint(account);",
    "startLine": 25,
    "endLine": 25,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 27,
    "endLine": 27,
    "event": "add"
  },
  {
    "code": "emit Transfer(msg.sender, account, amount);",
    "startLine": 28,
    "endLine": 28,
    "event": "add"
  },
  {
    "code": "return true;",
    "startLine": 29,
    "endLine": 29,
    "event": "add"
  },

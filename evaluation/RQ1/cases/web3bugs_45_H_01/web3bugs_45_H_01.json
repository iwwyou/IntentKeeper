    "startLine": 190,
    "endLine": 190,
    "event": "add"
  },
  {
    "code": "function exchangeRateCurrent() public nonReentrant returns (uint256) {\n}",
    "startLine": 191,
    "endLine": 192,
    "event": "add"
  },
  {
    "code": "require(accrueInterest(), \"UToken: accrue interest failed\");",
    "startLine": 192,
    "endLine": 192,
    "event": "add"
  },
  {
    "code": "return exchangeRateStored();",
    "startLine": 193,
    "endLine": 193,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 195,
    "endLine": 195,
    "event": "add"
  },
  {
    "code": "function borrow(uint256 amount) external onlyMember(msg.sender) whenNotPaused nonReentrant {\n}",
    "startLine": 196,
    "endLine": 197,
    "event": "add"
  },
  {
    "code": "IAssetManager assetManagerContract = IAssetManager(assetManager);",
    "startLine": 197,
    "endLine": 197,
    "event": "add"
  },
  {
    "code": "require(amount >= minBorrow, \"UToken: amount less than loan size min\");",
    "startLine": 198,
    "endLine": 198,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 199,
    "endLine": 199,
    "event": "add"
  },
  {
    "code": "require(amount <= getRemainingLoanSize(), \"UToken: amount more than loan global size max\");",
    "startLine": 200,
    "endLine": 200,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 201,
    "endLine": 201,
    "event": "add"
  },
  {
    "code": "uint256 fee = calculatingFee(amount);",
    "startLine": 202,
    "endLine": 202,
    "event": "add"
  },
  {
    "code": "require(borrowBalanceView(msg.sender) + amount + fee <= maxBorrow, \"UToken: amount large than borrow size max\");",
    "startLine": 203,
    "endLine": 203,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 204,
    "endLine": 204,
    "event": "add"
  },
  {
    "code": "require(!checkIsOverdue(msg.sender), \"UToken: Member has loans overdue\");",
    "startLine": 205,
    "endLine": 205,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 206,
    "endLine": 206,
    "event": "add"
  },
  {
    "code": "require(amount <= assetManagerContract.getLoanableAmount(underlying), \"UToken: Not enough to lend out\");",
    "startLine": 207,
    "endLine": 207,
    "event": "add"
  },
  {
    "code": "require( uint256(_getCreditLimit(msg.sender)) >= amount + fee, \"UToken: The loan amount plus fee is greater than credit limit\" );",
    "startLine": 208,
    "endLine": 211,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 212,
    "endLine": 212,
    "event": "add"
  },
  {
    "code": "require(accrueInterest(), \"UToken: accrue interest failed\");",
    "startLine": 213,
    "endLine": 213,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 214,
    "endLine": 214,
    "event": "add"
  },
  {
    "code": "uint256 borrowedAmount = borrowBalanceStoredInternal(msg.sender);",
    "startLine": 215,
    "endLine": 215,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 216,
    "endLine": 216,
    "event": "add"
  },
  {
    "code": "if (accountBorrows[msg.sender].lastRepay == 0) {\n}",
    "startLine": 217,
    "endLine": 218,
    "event": "add"
  },
  {
    "code": "accountBorrows[msg.sender].lastRepay = getBlockNumber();",
    "startLine": 218,
    "endLine": 218,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 220,
    "endLine": 220,
    "event": "add"
  },
  {
    "code": "uint256 accountBorrowsNew = borrowedAmount + amount + fee;",
    "startLine": 221,
    "endLine": 221,
    "event": "add"
  },
  {
    "code": "uint256 totalBorrowsNew = totalBorrows + amount + fee;",
    "startLine": 222,
    "endLine": 222,
    "event": "add"
  },
  {
    "code": "uint256 oldPrincipal = accountBorrows[msg.sender].principal;",
    "startLine": 223,
    "endLine": 223,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 224,
    "endLine": 224,
    "event": "add"
  },
  {
    "code": "accountBorrows[msg.sender].principal += amount + fee;",
    "startLine": 225,
    "endLine": 225,
    "event": "add"
  },
  {
    "code": "uint256 newPrincipal = accountBorrows[msg.sender].principal;",
    "startLine": 226,
    "endLine": 226,
    "event": "add"
  },
  {
    "code": "IUserManager(userManager).updateLockedData(msg.sender, newPrincipal - oldPrincipal, true);",
    "startLine": 227,
    "endLine": 227,
    "event": "add"
  },
  {
    "code": "accountBorrows[msg.sender].interest = accountBorrowsNew - accountBorrows[msg.sender].principal;",
    "startLine": 228,
    "endLine": 228,
    "event": "add"
  },
  {
    "code": "accountBorrows[msg.sender].interestIndex = borrowIndex;",
    "startLine": 229,
    "endLine": 229,
    "event": "add"
  },
  {
    "code": "totalBorrows = totalBorrowsNew;",
    "startLine": 230,
    "endLine": 230,
    "event": "add"
  },
  {
    "code": "totalReserves += fee;",
    "startLine": 231,
    "endLine": 231,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 232,
    "endLine": 232,
    "event": "add"
  },
  {
    "code": "require(assetManagerContract.withdraw(underlying, msg.sender, amount), \"UToken: Failed to withdraw\");",
    "startLine": 233,
    "endLine": 233,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 234,
    "endLine": 234,
    "event": "add"
  },
  {
    "code": "emit LogBorrow(msg.sender, amount, fee);",
    "startLine": 235,
    "endLine": 235,
    "event": "add"
  },

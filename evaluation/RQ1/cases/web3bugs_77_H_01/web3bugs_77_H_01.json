  },
  {
    "code": "function wMul(uint256 a, uint256 b) public pure returns (uint256) {\n}",
    "startLine": 24,
    "endLine": 25,
    "event": "add"
  },
  {
    "code": "return ((a * b) + (WAD / 2)) / WAD;",

  {
    "code": "function calculateLiquidityTokenQtyForSingleAssetEntry( uint256 _totalSupplyOfLiquidityTokens, uint256 _tokenQtyAToAdd, uint256 _internalTokenAReserveQty, uint256 _tokenBDecayChange, uint256 _tokenBDecay ) public pure returns (uint256 liquidityTokenQty) {\n}",
    "startLine": 28,
    "endLine": 35,
    "event": "add"
  },
  {
    "code": "uint256 wGamma = wDiv((wMul(wDiv(_tokenQtyAToAdd, _internalTokenAReserveQty),_tokenBDecayChange * WAD)),_tokenBDecay) / WAD / 2;",
    "startLine": 35,
    "endLine": 35,
    "event": "add"
  },

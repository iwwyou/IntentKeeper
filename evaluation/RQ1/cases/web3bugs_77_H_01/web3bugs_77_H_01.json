  },
  {
    "code": "function wDiv(uint256 a, uint256 b) public pure returns (uint256) {\n}",
    "startLine": 20,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "return ((a * WAD) + (b / 2)) / b;",

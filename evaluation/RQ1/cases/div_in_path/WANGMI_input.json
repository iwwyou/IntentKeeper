  },
  {
    "code": "contract WANGMI is ERC20, Ownable {\n}",
    "startLine": 307,
    "endLine": 308,
    "event": "add"
  },
  {
    "code": "using SafeMath for uint256;",
    "startLine": 308,
    "endLine": 308,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 309,
    "endLine": 309,
    "event": "add"
  },
  {
    "code": "IUniswapV2Router02 public constant uniswapV2Router = IUniswapV2Router02(0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D);",
    "startLine": 310,
    "endLine": 310,
    "event": "add"
  },
  {
    "code": "uint256 public buyLiquidityFee = 3;",
    "startLine": 311,
    "endLine": 311,
    "event": "add"
  },
  {
    "code": "uint256 public sellLiquidityFee = 3;",
    "startLine": 312,
    "endLine": 312,
    "event": "add"
  },
  {
    "code": "uint256 public buyTxFee = 9;",
    "startLine": 313,
    "endLine": 313,
    "event": "add"
  },
  {
    "code": "uint256 public sellTxFee = 9;",
    "startLine": 314,
    "endLine": 314,
    "event": "add"
  },
  {
    "code": "uint256 public tokensForLiquidity;",
    "startLine": 315,
    "endLine": 315,
    "event": "add"
  },
  {
    "code": "uint256 public tokensForTax;",
    "startLine": 316,
    "endLine": 316,
    "event": "add"
  },
  {
    "code": "uint256 public _tTotal = 10**9 * 10**9;",
    "startLine": 317,
    "endLine": 317,
    "event": "add"
  },
  {
    "code": "uint256 public swapAtAmount = _tTotal.mul(10).div(10000);",
    "startLine": 318,
    "endLine": 318,
    "event": "add"
  },
  {
    "code": "uint256 public maxTxLimit = _tTotal.mul(75).div(10000);",
    "startLine": 319,
    "endLine": 319,
    "event": "add"
  },
  {
    "code": "uint256 public maxWalletLimit = _tTotal.mul(150).div(10000);",
    "startLine": 320,
    "endLine": 320,
    "event": "add"
  },
  {
    "code": "address public dev;",
    "startLine": 321,
    "endLine": 321,
    "event": "add"
  },
  {
    "code": "address public deployer;",
    "startLine": 322,
    "endLine": 322,
    "event": "add"
  },
  {
    "code": "address public uniswapV2Pair;",
    "startLine": 323,
    "endLine": 323,
    "event": "add"
  },
  {
    "code": "uint256 private launchBlock;",
    "startLine": 324,
    "endLine": 324,
    "event": "add"
  },
  {
    "code": "bool private swapping;",
    "startLine": 325,
    "endLine": 325,
    "event": "add"
  },
  {
    "code": "bool public isLaunched;",
    "startLine": 326,
    "endLine": 326,
    "event": "add"
  },
  {
    "code": "mapping (address => bool) public isExcludedFromFees;",
    "startLine": 327,
    "endLine": 327,
    "event": "add"
  },
  {
    "code": "mapping (address => bool) public isExcludedFromTxLimit;",
    "startLine": 328,
    "endLine": 328,
    "event": "add"
  },
  {
    "code": "mapping (address => bool) public isExcludedFromWalletLimit;",
    "startLine": 329,
    "endLine": 329,
    "event": "add"
  },
  {
    "code": "mapping (address => bool) public isBlacklisted;",
    "startLine": 330,
    "endLine": 330,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 331,
    "endLine": 331,
    "event": "add"
  },
  {
    "code": "function _swapTokensForETH(uint256 tokenAmount) private {\n}",
    "startLine": 332,
    "endLine": 333,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 333,
    "endLine": 333,
    "event": "add"
  },
  {
    "code": "address[] memory path = new address[](2);",
    "startLine": 334,
    "endLine": 334,
    "event": "add"
  },
  {
    "code": "path[0] = address(this);",
    "startLine": 335,
    "endLine": 335,
    "event": "add"
  },
  {
    "code": "path[1] = uniswapV2Router.WETH();",
    "startLine": 336,
    "endLine": 336,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 337,
    "endLine": 337,
    "event": "add"
  },
  {
    "code": "uniswapV2Router.swapExactTokensForETHSupportingFeeOnTransferTokens( tokenAmount, 0, path, address(this), block.timestamp );",
    "startLine": 338,
    "endLine": 344,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 346,
    "endLine": 346,
    "event": "add"
  },
  {
    "code": "function _addLiquidity(uint256 tokenAmount, uint256 ethAmount) private {\n}",
    "startLine": 347,
    "endLine": 348,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 348,
    "endLine": 348,
    "event": "add"
  },
  {
    "code": "uniswapV2Router.addLiquidityETH{value: ethAmount}( address(this), tokenAmount, 0, 0, deployer, block.timestamp );",
    "startLine": 349,
    "endLine": 356,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 358,
    "endLine": 358,
    "event": "add"
  },
  {
    "code": "function swapBack(uint256 totalTokensForFee) private {\n}",
    "startLine": 359,
    "endLine": 360,
    "event": "add"
  },
  {
    "code": "uint256 toSwap = swapAtAmount;",
    "startLine": 360,
    "endLine": 360,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 361,
    "endLine": 361,
    "event": "add"
  },
  {
    "code": "uint256 liquidityTokens = toSwap.mul(tokensForLiquidity).div(totalTokensForFee).div(2);",
    "startLine": 362,
    "endLine": 362,
    "event": "add"
  },
  {
    "code": "uint256 taxTokens = toSwap.sub(liquidityTokens).sub(liquidityTokens);",
    "startLine": 363,
    "endLine": 363,
    "event": "add"
  },
  {
    "code": "uint256 amountToSwapForETH = toSwap.sub(liquidityTokens);",
    "startLine": 364,
    "endLine": 364,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 365,
    "endLine": 365,
    "event": "add"
  },
  {
    "code": "_swapTokensForETH(amountToSwapForETH);",
    "startLine": 366,
    "endLine": 366,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 367,
    "endLine": 367,
    "event": "add"
  },
  {
    "code": "uint256 ethBalance = address(this).balance;",
    "startLine": 368,
    "endLine": 368,
    "event": "add"
  },
  {
    "code": "uint256 ethForTax = ethBalance.mul(taxTokens).div(amountToSwapForETH);",
    "startLine": 369,
    "endLine": 369,
    "event": "add"
  },
  {
    "code": "uint256 ethForLiquidity = ethBalance.sub(ethForTax);",
    "startLine": 370,
    "endLine": 370,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 371,
    "endLine": 371,
    "event": "add"
  },
  {
    "code": "tokensForLiquidity = tokensForLiquidity.sub(liquidityTokens.mul(2));",
    "startLine": 372,
    "endLine": 372,
    "event": "add"
  },
  {
    "code": "tokensForTax = tokensForTax.sub(toSwap.sub(liquidityTokens.mul(2)));",
    "startLine": 373,
    "endLine": 373,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 374,
    "endLine": 374,
    "event": "add"
  },
  {
    "code": "payable(address(dev)).transfer(ethForTax);",
    "startLine": 375,
    "endLine": 375,
    "event": "add"
  },
  {
    "code": "_addLiquidity(liquidityTokens, ethForLiquidity);",
    "startLine": 376,
    "endLine": 376,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 378,
    "endLine": 378,
    "event": "add"
  },
  {
    "code": "function _setBlacklist(address account, bool value) internal {\n}",
    "startLine": 379,
    "endLine": 380,
    "event": "add"
  },
  {
    "code": "isBlacklisted[account] = value;",
    "startLine": 380,
    "endLine": 380,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 382,
    "endLine": 382,
    "event": "add"
  },
  {
    "code": "function _transfer(address _from, address to, uint256 amount) internal override {\n}",
    "startLine": 383,
    "endLine": 384,
    "event": "add"
  },
  {
    "code": "require(_from != address(0), \"transfer from the zero address\");",
    "startLine": 384,
    "endLine": 384,
    "event": "add"
  },
  {
    "code": "require(to != address(0), \"transfer to the zero address\");",
    "startLine": 385,
    "endLine": 385,
    "event": "add"
  },
  {
    "code": "require(amount <= maxTxLimit || isExcludedFromTxLimit[_from] || isExcludedFromTxLimit[to], \"Tx Amount too large\");",
    "startLine": 386,
    "endLine": 386,
    "event": "add"
  },
  {
    "code": "require(balanceOf(to).add(amount) <= maxWalletLimit || isExcludedFromWalletLimit[to], \"Transfer will exceed wallet limit\");",
    "startLine": 387,
    "endLine": 387,
    "event": "add"
  },
  {
    "code": "require(isLaunched || isExcludedFromFees[_from] || isExcludedFromFees[to], \"Waiting to go live\");",
    "startLine": 388,
    "endLine": 388,
    "event": "add"
  },
  {
    "code": "require(!isBlacklisted[_from], \"Sender is blacklisted\");",
    "startLine": 389,
    "endLine": 389,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 390,
    "endLine": 390,
    "event": "add"
  },
  {
    "code": "if(amount == 0) {\n}",
    "startLine": 391,
    "endLine": 392,
    "event": "add"
  },
  {
    "code": "super._transfer(_from, to, 0);",
    "startLine": 392,
    "endLine": 392,
    "event": "add"
  },
  {
    "code": "return;",
    "startLine": 393,
    "endLine": 393,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 395,
    "endLine": 395,
    "event": "add"
  },
  {
    "code": "uint256 totalTokensForFee = tokensForLiquidity + tokensForTax;",
    "startLine": 396,
    "endLine": 396,
    "event": "add"
  },
  {
    "code": "bool canSwap = totalTokensForFee >= swapAtAmount;",
    "startLine": 397,
    "endLine": 397,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 398,
    "endLine": 398,
    "event": "add"
  },
  {
    "code": "if( _from != uniswapV2Pair && canSwap && !swapping ) {\n}",
    "startLine": 399,
    "endLine": 404,
    "event": "add"
  },
  {
    "code": "swapping = true;",
    "startLine": 404,
    "endLine": 404,
    "event": "add"
  },
  {
    "code": "swapBack(totalTokensForFee);",
    "startLine": 405,
    "endLine": 405,
    "event": "add"
  },
  {
    "code": "swapping = false;",
    "startLine": 406,
    "endLine": 406,
    "event": "add"
  },
  {
    "code": "else if( _from == uniswapV2Pair && to != uniswapV2Pair && block.number < launchBlock + 2 && !isExcludedFromFees[to] ) {\n}",
    "startLine": 407,
    "endLine": 413,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "_setBlacklist(to, true);",
    "startLine": 413,
    "endLine": 413,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 415,
    "endLine": 415,
    "event": "add"
  },
  {
    "code": "bool takeFee = !swapping;",
    "startLine": 416,
    "endLine": 416,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 417,
    "endLine": 417,
    "event": "add"
  },
  {
    "code": "if(isExcludedFromFees[_from] || isExcludedFromFees[to]) {\n}",
    "startLine": 418,
    "endLine": 419,
    "event": "add"
  },
  {
    "code": "takeFee = false;",
    "startLine": 419,
    "endLine": 419,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 421,
    "endLine": 421,
    "event": "add"
  },
  {
    "code": "if(takeFee) {\n}",
    "startLine": 422,
    "endLine": 423,
    "event": "add"
  },
  {
    "code": "uint256 fees;",
    "startLine": 423,
    "endLine": 423,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 424,
    "endLine": 424,
    "event": "add"
  },
  {
    "code": "if (to == uniswapV2Pair) {\n}",
    "startLine": 425,
    "endLine": 426,
    "event": "add"
  },
  {
    "code": "uint256 sellTotalFees = sellLiquidityFee.add(sellTxFee);",
    "startLine": 426,
    "endLine": 426,
    "event": "add"
  },
  {
    "code": "fees = amount.mul(sellTotalFees).div(100);",
    "startLine": 427,
    "endLine": 427,
    "event": "add"
  },
  {
    "code": "tokensForLiquidity = tokensForLiquidity.add(fees.mul(sellLiquidityFee).div(sellTotalFees));",
    "startLine": 428,
    "endLine": 428,
    "event": "add"
  },
  {
    "code": "tokensForTax = tokensForTax.add(fees.mul(sellTxFee).div(sellTotalFees));",
    "startLine": 429,
    "endLine": 429,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 431,
    "endLine": 432,
    "event": "add"
  },
  {
    "code": "uint256 buyTotalFees = buyLiquidityFee.add(buyTxFee);",
    "startLine": 432,
    "endLine": 432,
    "event": "add"
  },
  {
    "code": "fees = amount.mul(buyTotalFees).div(100);",
    "startLine": 433,
    "endLine": 433,
    "event": "add"
  },
  {
    "code": "tokensForLiquidity = tokensForLiquidity.add(fees.mul(buyLiquidityFee).div(buyTotalFees));",
    "startLine": 434,
    "endLine": 434,
    "event": "add"
  },
  {
    "code": "tokensForTax = tokensForTax.add(fees.mul(buyTxFee).div(buyTotalFees));",
    "startLine": 435,
    "endLine": 435,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 437,
    "endLine": 437,
    "event": "add"
  },
  {
    "code": "if(fees > 0){\n}",
    "startLine": 438,
    "endLine": 439,
    "event": "add"
  },
  {
    "code": "super._transfer(_from, address(this), fees);",
    "startLine": 439,
    "endLine": 439,
    "event": "add"
  },
  {
    "code": "amount = amount.sub(fees);",
    "startLine": 440,
    "endLine": 440,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 443,
    "endLine": 443,
    "event": "add"
  },
  {
    "code": "super._transfer(_from, to, amount);",
    "startLine": 444,
    "endLine": 444,
    "event": "add"
  },

  {
    "code": "function _burn(address account, uint256 amount) internal virtual {\n}",
    "startLine": 296,
    "endLine": 297,
    "event": "add"
  },
  {
    "code": "require(account != address(0), \"ERC20: burn from the zero address\");",
    "startLine": 297,
    "endLine": 297,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 298,
    "endLine": 298,
    "event": "add"
  },
  {
    "code": "_beforeTokenTransfer(account, address(0), amount);",
    "startLine": 299,
    "endLine": 299,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 300,
    "endLine": 300,
    "event": "add"
  },
  {
    "code": "_balances[account] = _balances[account].sub(amount, \"ERC20: burn amount exceeds balance\");",
    "startLine": 301,
    "endLine": 301,
    "event": "add"
  },
  {
    "code": "_totalSupply = _totalSupply.sub(amount);",
    "startLine": 302,

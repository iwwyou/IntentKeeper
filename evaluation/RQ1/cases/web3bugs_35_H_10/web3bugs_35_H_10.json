  {
    "code": "function _getAmountsForLiquidity( uint256 priceLower, uint256 priceUpper, uint256 currentPrice, uint256 liquidityAmount ) internal pure returns (uint128 token0amount, uint128 token1amount) {\n}",
    "startLine": 80,
    "endLine": 86,
    "event": "add"
  },
  {
    "code": "if (priceUpper <= currentPrice) {\n}",
    "startLine": 86,
    "endLine": 87,
    "event": "add"
  },
  {
    "code": "token1amount = uint128(DyDxMath.getDy(liquidityAmount, priceLower, priceUpper, true));",
    "startLine": 87,
    "endLine": 87,
    "event": "add"
  },
  {
    "code": "else if (currentPrice <= priceLower) {\n}",
    "startLine": 88,
    "endLine": 89,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "token0amount = uint128(DyDxMath.getDx(liquidityAmount, priceLower, priceUpper, true));",
    "startLine": 89,
    "endLine": 89,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 90,
    "endLine": 91,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "token0amount = uint128(DyDxMath.getDx(liquidityAmount, currentPrice, priceUpper, true));",
    "startLine": 91,
    "endLine": 91,
    "event": "add"
  },
  {
    "code": "token1amount = uint128(DyDxMath.getDy(liquidityAmount, priceLower, currentPrice, true));",
    "startLine": 92,
    "endLine": 92,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 95,
    "endLine": 95,
    "event": "add"
  },
  {
    "code": "function _updatePosition( address owner, int24 lower, int24 upper, int128 amount ) internal returns (uint256 amount0fees, uint256 amount1fees) {\n}",
    "startLine": 96,
    "endLine": 102,
    "event": "add"
  },
  {
    "code": "Position storage position = positions[owner][lower][upper];",
    "startLine": 102,
    "endLine": 102,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 103,
    "endLine": 103,
    "event": "add"
  },
  {
    "code": "(uint256 growth0current, uint256 growth1current) = rangeFeeGrowth(lower, upper);",
    "startLine": 104,
    "endLine": 104,
    "event": "add"
  },
  {
    "code": "amount0fees = FullMath.mulDiv( growth0current - position.feeGrowthInside0Last, position.liquidity, 0x100000000000000000000000000000000 );",
    "startLine": 105,
    "endLine": 109,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 110,
    "endLine": 110,
    "event": "add"
  },
  {
    "code": "amount1fees = FullMath.mulDiv( growth1current - position.feeGrowthInside1Last, position.liquidity, 0x100000000000000000000000000000000 );",
    "startLine": 111,
    "endLine": 115,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 116,
    "endLine": 116,
    "event": "add"
  },
  {
    "code": "if (amount < 0) position.liquidity -= uint128(-amount);",
    "startLine": 117,
    "endLine": 117,
    "event": "add"
  },
  {
    "code": "if (amount > 0) position.liquidity += uint128(amount);",
    "startLine": 118,
    "endLine": 118,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 119,
    "endLine": 119,
    "event": "add"
  },
  {
    "code": "require(position.liquidity < MAX_TICK_LIQUIDITY, \"MAX_TICK_LIQUIDITY\");",
    "startLine": 120,
    "endLine": 120,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 121,
    "endLine": 121,
    "event": "add"
  },
  {
    "code": "position.feeGrowthInside0Last = growth0current;",
    "startLine": 122,
    "endLine": 122,
    "event": "add"
  },
  {
    "code": "position.feeGrowthInside1Last = growth1current;",
    "startLine": 123,
    "endLine": 123,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 125,
    "endLine": 125,
    "event": "add"
  },
  {
    "code": "function _transferBothTokens( address to, uint256 shares0, uint256 shares1, bool unwrapBento ) internal {\n}",
    "startLine": 126,
    "endLine": 132,
    "event": "add"
  },
  {
    "code": "if (unwrapBento) {\n}",
    "startLine": 132,
    "endLine": 133,
    "event": "add"
  },
  {
    "code": "bento.withdraw(token0, address(this), to, 0, shares0);",
    "startLine": 133,
    "endLine": 133,
    "event": "add"
  },
  {
    "code": "bento.withdraw(token1, address(this), to, 0, shares1);",
    "startLine": 134,
    "endLine": 134,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 135,
    "endLine": 136,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "bento.transfer(token0, address(this), to, shares0);",
    "startLine": 136,
    "endLine": 136,
    "event": "add"
  },
  {
    "code": "bento.transfer(token1, address(this), to, shares1);",
    "startLine": 137,
    "endLine": 137,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 140,
    "endLine": 140,
    "event": "add"
  },
  {
    "code": "function burn(bytes calldata data) public lock returns (IPool.TokenAmount[] memory withdrawnAmounts) {\n}",
    "startLine": 141,
    "endLine": 142,
    "event": "add"
  },
  {
    "code": "(int24 lower, int24 upper, uint128 amount, address recipient, bool unwrapBento) = abi.decode( data, (int24, int24, uint128, address, bool) );",
    "startLine": 142,
    "endLine": 145,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 146,
    "endLine": 146,
    "event": "add"
  },
  {
    "code": "uint160 priceLower = TickMath.getSqrtRatioAtTick(lower);",
    "startLine": 147,
    "endLine": 147,
    "event": "add"
  },
  {
    "code": "uint160 priceUpper = TickMath.getSqrtRatioAtTick(upper);",
    "startLine": 148,
    "endLine": 148,
    "event": "add"
  },
  {
    "code": "uint160 currentPrice = price;",
    "startLine": 149,
    "endLine": 149,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 150,
    "endLine": 150,
    "event": "add"
  },
  {
    "code": "unchecked {\n}",
    "startLine": 151,
    "endLine": 152,
    "event": "add"
  },
  {
    "code": "if (priceLower < currentPrice && currentPrice < priceUpper) liquidity -= amount;",
    "startLine": 152,
    "endLine": 152,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 154,
    "endLine": 154,
    "event": "add"
  },
  {
    "code": "(uint256 amount0, uint256 amount1) = _getAmountsForLiquidity( uint256(priceLower), uint256(priceUpper), uint256(currentPrice), uint256(amount) );",
    "startLine": 155,
    "endLine": 160,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 161,
    "endLine": 161,
    "event": "add"
  },
  {
    "code": "(uint256 amount0fees, uint256 amount1fees) = _updatePosition(msg.sender, lower, upper, -int128(amount));",
    "startLine": 162,
    "endLine": 162,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 163,
    "endLine": 163,
    "event": "add"
  },
  {
    "code": "unchecked {\n}",
    "startLine": 164,
    "endLine": 165,
    "event": "add"
  },
  {
    "code": "amount0 += amount0fees;",
    "startLine": 165,
    "endLine": 165,
    "event": "add"
  },
  {
    "code": "amount1 += amount1fees;",
    "startLine": 166,
    "endLine": 166,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 168,
    "endLine": 168,
    "event": "add"
  },
  {
    "code": "withdrawnAmounts = new IPool.TokenAmount[](2);",
    "startLine": 169,
    "endLine": 169,
    "event": "add"
  },
  {
    "code": "withdrawnAmounts[0] = IPool.TokenAmount({token: token0, amount: amount0});",
    "startLine": 170,
    "endLine": 170,
    "event": "add"
  },
  {
    "code": "withdrawnAmounts[1] = IPool.TokenAmount({token: token1, amount: amount1});",
    "startLine": 171,
    "endLine": 171,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 172,
    "endLine": 172,
    "event": "add"
  },
  {
    "code": "unchecked {\n}",
    "startLine": 173,
    "endLine": 174,
    "event": "add"
  },
  {
    "code": "reserve0 -= uint128(amount0fees);",
    "startLine": 174,
    "endLine": 174,
    "event": "add"
  },
  {
    "code": "reserve1 -= uint128(amount1fees);",
    "startLine": 175,
    "endLine": 175,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 177,
    "endLine": 177,
    "event": "add"
  },
  {
    "code": "_transferBothTokens(recipient, amount0, amount1, unwrapBento);",
    "startLine": 178,
    "endLine": 178,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 179,
    "endLine": 179,
    "event": "add"
  },
  {
    "code": "nearestTick = Ticks.remove(ticks, lower, upper, amount, nearestTick);",
    "startLine": 180,
    "endLine": 180,
    "event": "add"
  },
  {
    "code": "emit Burn(msg.sender, amount0, amount1, recipient);",
    "startLine": 181,
    "endLine": 181,
    "event": "add"
  },

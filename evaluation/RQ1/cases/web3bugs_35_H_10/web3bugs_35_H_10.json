  {
    "code": "function rangeFeeGrowth(int24 lowerTick, int24 upperTick) public view returns (uint256 feeGrowthInside0, uint256 feeGrowthInside1) {\n}",
    "startLine": 47,
    "endLine": 48,
    "event": "add"
  },
  {
    "code": "int24 currentTick = nearestTick;",
    "startLine": 48,
    "endLine": 48,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 49,
    "endLine": 49,
    "event": "add"
  },
  {
    "code": "Ticks.Tick storage lower = ticks[lowerTick];",
    "startLine": 50,
    "endLine": 50,
    "event": "add"
  },
  {
    "code": "Ticks.Tick storage upper = ticks[upperTick];",
    "startLine": 51,
    "endLine": 51,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 52,
    "endLine": 52,
    "event": "add"
  },
  {
    "code": "uint256 _feeGrowthGlobal0 = feeGrowthGlobal0;",
    "startLine": 53,
    "endLine": 53,
    "event": "add"
  },
  {
    "code": "uint256 _feeGrowthGlobal1 = feeGrowthGlobal1;",
    "startLine": 54,
    "endLine": 54,
    "event": "add"
  },
  {
    "code": "uint256 feeGrowthBelow0;",
    "startLine": 55,
    "endLine": 55,
    "event": "add"
  },
  {
    "code": "uint256 feeGrowthBelow1;",
    "startLine": 56,
    "endLine": 56,
    "event": "add"
  },
  {
    "code": "uint256 feeGrowthAbove0;",
    "startLine": 57,
    "endLine": 57,
    "event": "add"
  },
  {
    "code": "uint256 feeGrowthAbove1;",
    "startLine": 58,
    "endLine": 58,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 59,
    "endLine": 59,
    "event": "add"
  },
  {
    "code": "if (lowerTick <= currentTick) {\n}",
    "startLine": 60,
    "endLine": 61,
    "event": "add"
  },
  {
    "code": "feeGrowthBelow0 = lower.feeGrowthOutside0;",
    "startLine": 61,
    "endLine": 61,
    "event": "add"
  },
  {
    "code": "feeGrowthBelow1 = lower.feeGrowthOutside1;",
    "startLine": 62,
    "endLine": 62,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 63,
    "endLine": 64,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "feeGrowthBelow0 = _feeGrowthGlobal0 - lower.feeGrowthOutside0;",
    "startLine": 64,
    "endLine": 64,
    "event": "add"
  },
  {
    "code": "feeGrowthBelow1 = _feeGrowthGlobal1 - lower.feeGrowthOutside1;",
    "startLine": 65,
    "endLine": 65,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 67,
    "endLine": 67,
    "event": "add"
  },
  {
    "code": "if (currentTick < upperTick) {\n}",
    "startLine": 68,
    "endLine": 69,
    "event": "add"
  },
  {
    "code": "feeGrowthAbove0 = upper.feeGrowthOutside0;",
    "startLine": 69,
    "endLine": 69,
    "event": "add"
  },
  {
    "code": "feeGrowthAbove1 = upper.feeGrowthOutside1;",
    "startLine": 70,
    "endLine": 70,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 71,
    "endLine": 72,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "feeGrowthAbove0 = _feeGrowthGlobal0 - upper.feeGrowthOutside0;",
    "startLine": 72,
    "endLine": 72,
    "event": "add"
  },
  {
    "code": "feeGrowthAbove1 = _feeGrowthGlobal1 - upper.feeGrowthOutside1;",
    "startLine": 73,
    "endLine": 73,
    "event": "add"
  },

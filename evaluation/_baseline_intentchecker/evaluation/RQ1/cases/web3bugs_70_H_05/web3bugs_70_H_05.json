    "startLine": 2,
    "endLine": 2,
    "event": "add"
  },
  {
    "code": "contract LiquidityBasedTWAP is ILiquidityBasedTWAP, Ownable {\n}",
    "startLine": 3,
    "endLine": 4,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 4,
    "endLine": 4,
    "event": "add"
  },
  {
    "code": "using FixedPoint for FixedPoint.uq112x112;",
    "startLine": 5,
    "endLine": 5,
    "event": "add"
  },
  {
    "code": "using FixedPoint for FixedPoint.uq144x112;",
    "startLine": 6,
    "endLine": 6,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 7,
    "endLine": 7,
    "event": "add"
  },
  {
    "code": "IERC20[] public usdvPairs;",
    "startLine": 8,
    "endLine": 8,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 9,
    "endLine": 9,
    "event": "add"
  },
  {
    "code": "mapping(address => ExchangePair) public twapData;",
    "startLine": 10,
    "endLine": 10,
    "event": "add"
  },
  {
    "code": "mapping(address => IAggregatorV3) public oracles;",
    "startLine": 11,
    "endLine": 11,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 12,
    "endLine": 12,
    "event": "add"
  },
  {
    "code": "function getChainlinkPrice(address asset) public view returns (uint256) {\n}",
    "startLine": 13,
    "endLine": 14,
    "event": "add"
  },
  {
    "code": "IAggregatorV3 oracle = oracles[asset];",
    "startLine": 14,
    "endLine": 14,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 15,
    "endLine": 15,
    "event": "add"
  },
  {
    "code": "(uint80 roundID, int256 price, , , uint80 answeredInRound) = oracle .latestRoundData();",
    "startLine": 16,
    "endLine": 17,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 18,
    "endLine": 18,
    "event": "add"
  },
  {
    "code": "require( answeredInRound >= roundID, \"LBTWAP::getChainlinkPrice: Stale Chainlink Price\" );",
    "startLine": 19,
    "endLine": 22,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 23,
    "endLine": 23,
    "event": "add"
  },
  {
    "code": "require(price > 0, \"LBTWAP::getChainlinkPrice: Chainlink Malfunction\");",
    "startLine": 24,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 25,
    "endLine": 25,
    "event": "add"
  },
  {
    "code": "return uint256(price);",
    "startLine": 26,
    "endLine": 26,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 28,
    "endLine": 28,
    "event": "add"
  },
  {
    "code": "function _calculateUSDVPrice( uint256[] memory liquidityWeights, uint256 totalUSDVLiquidityWeight ) internal view returns (uint256) {\n}",
    "startLine": 29,
    "endLine": 33,
    "event": "add"
  },
  {
    "code": "uint256 totalUSD;",
    "startLine": 33,
    "endLine": 33,
    "event": "add"
  },
  {
    "code": "uint256 totalUSDV;",
    "startLine": 34,
    "endLine": 34,
    "event": "add"
  },
  {
    "code": "uint256 totalPairs = usdvPairs.length;",
    "startLine": 35,
    "endLine": 35,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 36,
    "endLine": 36,
    "event": "add"
  },
  {
    "code": "for (uint256 i; i < totalPairs; ++i) {\n}",
    "startLine": 37,
    "endLine": 38,
    "event": "add"
  },
  {
    "code": "IERC20 foreignAsset = usdvPairs[i];",
    "startLine": 38,
    "endLine": 38,
    "event": "add"
  },
  {
    "code": "ExchangePair storage pairData = twapData[address(foreignAsset)];",
    "startLine": 39,
    "endLine": 39,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 40,
    "endLine": 40,
    "event": "add"
  },
  {
    "code": "uint256 foreignPrice = getChainlinkPrice(address(foreignAsset));",
    "startLine": 41,
    "endLine": 41,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 42,
    "endLine": 42,
    "event": "add"
  },
  {
    "code": "totalUSD += (foreignPrice * liquidityWeights[i]) / totalUSDVLiquidityWeight;",
    "startLine": 43,
    "endLine": 45,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 46,
    "endLine": 46,
    "event": "add"
  },
  {
    "code": "totalUSDV += (pairData .nativeTokenPriceAverage .mul(pairData.foreignUnit) .decode144() * liquidityWeights[i]) / totalUSDVLiquidityWeight;",
    "startLine": 47,
    "endLine": 52,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 54,
    "endLine": 54,
    "event": "add"
  },
  {
    "code": "return (totalUSD * 1 ether) / totalUSDV;",
    "startLine": 55,
    "endLine": 55,
    "event": "add"
  },
  {
    "code": "// @Post returnExpression == (totalUSD * (10 ** 10) * (10 ** 18)) / totalUSDV",
    "startLine": 56,
    "endLine": 56,
    "event": "add"
  },
  {

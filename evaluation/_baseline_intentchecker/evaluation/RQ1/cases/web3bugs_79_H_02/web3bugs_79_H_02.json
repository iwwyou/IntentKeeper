  {
    "code": "function createPair() external isStopped(false) atPhase(PHASE_THREE) {\n}",
    "startLine": 129,
    "endLine": 130,
    "event": "add"
  },
  {
    "code": "(address wavaxAddress, address tokenAddress) = (address(WAVAX), address(token));",
    "startLine": 130,
    "endLine": 130,
    "event": "add"
  },
  {
    "code": "require(factory.getPair(wavaxAddress, tokenAddress) == address(0) || IJoePair(IJoeFactory(factory).getPair(wavaxAddress, tokenAddress)).totalSupply() == 0, \"LaunchEvent: liquid pair already exists\");",
    "startLine": 131,
    "endLine": 131,
    "event": "add"
  },
  {
    "code": "require(wavaxReserve > 0, \"LaunchEvent: no wavax balance\");",
    "startLine": 132,
    "endLine": 132,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 133,
    "endLine": 133,
    "event": "add"
  },
  {
    "code": "uint256 tokenAllocated = tokenReserve;",
    "startLine": 134,

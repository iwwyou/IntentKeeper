    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 144,
    "endLine": 144,
    "event": "add"
  },
  {
    "code": "(, , lpSupply) = router.addLiquidity(wavaxAddress, tokenAddress, wavaxReserve, tokenAllocated, wavaxReserve, tokenAllocated, address(this), block.timestamp);",
    "startLine": 145,
    "endLine": 145,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 146,
    "endLine": 146,
    "event": "add"
  },
  {
    "code": "pair = IJoePair(factory.getPair(tokenAddress, wavaxAddress));",
    "startLine": 147,
    "endLine": 147,
    "event": "add"
  },
  {
    "code": "wavaxAllocated = wavaxReserve;",
    "startLine": 148,
    "endLine": 148,
    "event": "add"
  },
  {
    "code": "wavaxReserve = 0;",
    "startLine": 149,
    "endLine": 149,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 150,
    "endLine": 150,
    "event": "add"
  },
  {
    "code": "tokenReserve -= tokenAllocated;",
    "startLine": 151,
    "endLine": 151,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 152,
    "endLine": 152,
    "event": "add"
  },
  {

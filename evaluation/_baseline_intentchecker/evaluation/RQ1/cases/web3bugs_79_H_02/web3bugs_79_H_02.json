  {
    "code": "\n",
    "startLine": 135,
    "endLine": 135,
    "event": "add"
  },
  {
    "code": "if (floorPrice > (wavaxReserve * 10**token.decimals()) / tokenAllocated ) {\n}",
    "startLine": 136,
    "endLine": 137,
    "event": "add"
  },
  {
    "code": "tokenAllocated = (wavaxReserve * 10**token.decimals()) / floorPrice;",
    "startLine": 137,
    "endLine": 137,
    "event": "add"
  },
  {
    "code": "tokenIncentivesForUsers = (tokenIncentivesForUsers * tokenAllocated) / tokenReserve;",
    "startLine": 138,
    "endLine": 138,
    "event": "add"
  },
  {
    "code": "tokenIncentiveIssuerRefund = tokenIncentivesBalance - tokenIncentivesForUsers;",
    "startLine": 139,

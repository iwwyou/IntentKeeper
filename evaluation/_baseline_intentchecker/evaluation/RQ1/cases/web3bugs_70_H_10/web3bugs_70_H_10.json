  {
    "code": "function syncVaderPrice() public override returns ( uint256[] memory pastLiquidityWeights, uint256 pastTotalLiquidityWeight ) {\n}",
    "startLine": 77,
    "endLine": 85,
    "event": "add"
  },
  {
    "code": "uint256 _totalLiquidityWeight;",
    "startLine": 85,
    "endLine": 85,
    "event": "add"
  },
  {
    "code": "uint256 totalPairs = vaderPairs.length;",
    "startLine": 86,
    "endLine": 86,
    "event": "add"
  },
  {
    "code": "pastLiquidityWeights = new uint256[](totalPairs);",
    "startLine": 87,
    "endLine": 87,
    "event": "add"
  },
  {
    "code": "pastTotalLiquidityWeight = totalLiquidityWeight[uint256(Paths.VADER)];",
    "startLine": 88,
    "endLine": 88,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 89,
    "endLine": 89,
    "event": "add"
  },
  {
    "code": "for (uint256 i; i < totalPairs; ++i) {\n}",
    "startLine": 90,
    "endLine": 91,
    "event": "add"
  },
  {
    "code": "IUniswapV2Pair pair = vaderPairs[i];",
    "startLine": 91,
    "endLine": 91,
    "event": "add"
  },
  {
    "code": "ExchangePair storage pairData = twapData[address(pair)];",
    "startLine": 92,
    "endLine": 92,
    "event": "add"
  },
  {
    "code": "uint256 timeElapsed = block.timestamp - pairData.lastMeasurement;",
    "startLine": 93,
    "endLine": 93,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 94,
    "endLine": 94,
    "event": "add"
  },
  {
    "code": "if (timeElapsed < pairData.updatePeriod) {\n}",
    "startLine": 95,
    "endLine": 96,
    "event": "add"
  },
  {
    "code": "continue;",
    "startLine": 96,
    "endLine": 96,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 98,
    "endLine": 98,
    "event": "add"
  },
  {
    "code": "uint256 pastLiquidityEvaluation = pairData.pastLiquidityEvaluation;",
    "startLine": 99,
    "endLine": 99,
    "event": "add"
  },
  {
    "code": "uint256 currentLiquidityEvaluation = _updateVaderPrice( pair, pairData, timeElapsed );",
    "startLine": 100,
    "endLine": 104,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 105,
    "endLine": 105,
    "event": "add"
  },
  {
    "code": "pastLiquidityWeights[i] = pastLiquidityEvaluation;",
    "startLine": 106,
    "endLine": 106,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 107,
    "endLine": 107,
    "event": "add"
  },
  {
    "code": "pairData.pastLiquidityEvaluation = currentLiquidityEvaluation;",
    "startLine": 108,
    "endLine": 108,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 109,
    "endLine": 109,
    "event": "add"
  },
  {
    "code": "_totalLiquidityWeight += currentLiquidityEvaluation;",
    "startLine": 110,
    "endLine": 110,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 112,
    "endLine": 112,
    "event": "add"
  },
  {
    "code": "totalLiquidityWeight[uint256(Paths.VADER)] = _totalLiquidityWeight;",
    "startLine": 113,
    "endLine": 113,
    "event": "add"

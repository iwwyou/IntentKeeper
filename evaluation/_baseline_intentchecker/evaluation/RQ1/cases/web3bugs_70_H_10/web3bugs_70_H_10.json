  {
    "code": "function getChainlinkPrice(address asset) public view returns (uint256) {\n}",
    "startLine": 20,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "IAggregatorV3 oracle = oracles[asset];",
    "startLine": 21,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 22,
    "endLine": 22,
    "event": "add"
  },
  {
    "code": "(uint80 roundID, int256 price, , , uint80 answeredInRound) = oracle .latestRoundData();",
    "startLine": 23,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 25,
    "endLine": 25,
    "event": "add"
  },
  {
    "code": "require( answeredInRound >= roundID, \"LBTWAP::getChainlinkPrice: Stale Chainlink Price\" );",
    "startLine": 26,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 30,
    "endLine": 30,
    "event": "add"
  },
  {
    "code": "require(price > 0, \"LBTWAP::getChainlinkPrice: Chainlink Malfunction\");",
    "startLine": 31,
    "endLine": 31,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 32,
    "endLine": 32,
    "event": "add"
  },
  {
    "code": "return uint256(price);",
    "startLine": 33,
    "endLine": 33,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 35,
    "endLine": 35,
    "event": "add"
  },
  {
    "code": "function _updateVaderPrice( IUniswapV2Pair pair, ExchangePair storage pairData, uint256 timeElapsed ) internal returns (uint256 currentLiquidityEvaluation) {\n}",
    "startLine": 36,
    "endLine": 41,
    "event": "add"
  },
  {
    "code": "bool isFirst = pair.token0() == vader;",
    "startLine": 41,
    "endLine": 41,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 42,
    "endLine": 42,
    "event": "add"
  },
  {
    "code": "(uint256 reserve0, uint256 reserve1, ) = pair.getReserves();",
    "startLine": 43,
    "endLine": 43,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 44,
    "endLine": 44,
    "event": "add"
  },
  {
    "code": "(uint256 reserveNative, uint256 reserveForeign) = isFirst ? (reserve0, reserve1) : (reserve1, reserve0);",
    "startLine": 45,
    "endLine": 47,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 48,
    "endLine": 48,
    "event": "add"
  },
  {
    "code": "( uint256 price0Cumulative, uint256 price1Cumulative, uint256 currentMeasurement ) = UniswapV2OracleLibrary.currentCumulativePrices(address(pair));",
    "startLine": 49,
    "endLine": 53,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 54,
    "endLine": 54,
    "event": "add"
  },
  {
    "code": "uint256 nativeTokenPriceCumulative = isFirst ? price0Cumulative : price1Cumulative;",
    "startLine": 55,
    "endLine": 57,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 58,
    "endLine": 58,
    "event": "add"
  },
  {
    "code": "unchecked {\n}",
    "startLine": 59,
    "endLine": 60,
    "event": "add"
  },
  {
    "code": "pairData.nativeTokenPriceAverage = FixedPoint.uq112x112( uint224( (nativeTokenPriceCumulative - pairData.nativeTokenPriceCumulative) / timeElapsed ) );",
    "startLine": 60,
    "endLine": 65,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 67,
    "endLine": 67,
    "event": "add"
  },
  {
    "code": "pairData.nativeTokenPriceCumulative = nativeTokenPriceCumulative;",
    "startLine": 68,
    "endLine": 68,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 69,
    "endLine": 69,
    "event": "add"
  },
  {
    "code": "pairData.lastMeasurement = currentMeasurement;",
    "startLine": 70,
    "endLine": 70,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 71,
    "endLine": 71,
    "event": "add"
  },
  {
    "code": "currentLiquidityEvaluation = (reserveNative * previousPrices[uint256(Paths.VADER)]) + (reserveForeign * getChainlinkPrice(pairData.foreignAsset));",
    "startLine": 72,
    "endLine": 74,
    "event": "add"

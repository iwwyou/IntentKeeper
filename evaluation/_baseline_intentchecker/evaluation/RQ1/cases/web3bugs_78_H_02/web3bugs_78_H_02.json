  },
  {
    "code": "function redeemRate() public view returns (uint256) {\n}",
    "startLine": 5,
    "endLine": 6,
    "event": "add"
  },
  {
    "code": "uint256 balanceOfBase = IERC20(baseToken).balanceOf(address(this));",
    "startLine": 6,
    "endLine": 6,
    "event": "add"
  },
  {
    "code": "if (totalSupply() == 0 || balanceOfBase == 0) {\n}",
    "startLine": 7,
    "endLine": 8,
    "event": "add"
  },
  {
    "code": "return ONE;",
    "startLine": 8,
    "endLine": 8,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 10,
    "endLine": 10,
    "event": "add"
  },
  {
    "code": "return (balanceOfBase * ONE) / totalSupply();",
    "startLine": 11,
    "endLine": 11,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 13,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "function mint(address to, uint256 amount) public override returns (uint256) {\n}",
    "startLine": 14,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "uint256 _redeemRate = redeemRate();",
    "startLine": 19,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "require(IERC20(baseToken).transferFrom(msg.sender, address(this), amount));",
    "startLine": 20,
    "endLine": 20,
    "event": "add"
  },
  {
    "code": "uint256 baseBalance = IERC20(baseToken).balanceOf(address(this));",
    "startLine": 21,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "uint256 proxy = (baseBalance * ONE) / _redeemRate;",
    "startLine": 22,
    "endLine": 22,
    "event": "add"
  },
  {
    "code": "_mint(to, proxy);",
    "startLine": 23,
    "endLine": 23,
    "event": "add"
  },

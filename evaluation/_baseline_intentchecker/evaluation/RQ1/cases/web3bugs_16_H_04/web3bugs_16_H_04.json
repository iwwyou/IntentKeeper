    "startLine": 13,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 15,
    "endLine": 15,
    "event": "add"
  },
  {
    "code": "struct Trade {\n}",
    "startLine": 16,
    "endLine": 17,

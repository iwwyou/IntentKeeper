  },
  {
    "code": "\n",
    "startLine": 10,
    "endLine": 10,
    "event": "add"
  },
  {
    "code": "struct Position {\n}",
    "startLine": 11,
    "endLine": 12,
    "event": "add"
  },
  {
    "code": "int256 quote;",
    "startLine": 12,
    "endLine": 12,
    "event": "add"
  },
  {

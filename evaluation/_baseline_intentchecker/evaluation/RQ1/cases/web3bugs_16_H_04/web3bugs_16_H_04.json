  },
  {
    "code": "function getFee( uint256 amount, uint256 executionPrice, uint256 feeRate ) internal pure returns (int256) {\n}",
    "startLine": 22,
    "endLine": 27,
    "event": "add"
  },
  {
    "code": "uint256 quoteChange = PRBMathUD60x18.mul(amount, executionPrice);",
    "startLine": 27,
    "endLine": 27,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 28,
    "endLine": 28,
    "event": "add"
  },
  {
    "code": "int256 fee = PRBMathUD60x18.mul(quoteChange, feeRate).toInt256();",
    "startLine": 29,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "return fee;",
    "startLine": 30,
    "endLine": 30,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 32,
    "endLine": 32,
    "event": "add"
  },
  {
    "code": "function applyTrade( Position memory position, Trade memory trade, uint256 feeRate ) internal pure returns (Position memory) {\n}",
    "startLine": 33,
    "endLine": 38,
    "event": "add"
  },
  {
    "code": "int256 signedAmount = LibMath.toInt256(trade.amount);",
    "startLine": 38,
    "endLine": 38,
    "event": "add"
  },
  {
    "code": "int256 signedPrice = LibMath.toInt256(trade.price);",
    "startLine": 39,
    "endLine": 39,
    "event": "add"
  },
  {
    "code": "int256 quoteChange = PRBMathSD59x18.mul(signedAmount, signedPrice);",
    "startLine": 40,
    "endLine": 40,
    "event": "add"
  },
  {
    "code": "int256 fee = getFee(trade.amount, trade.price, feeRate);",
    "startLine": 41,
    "endLine": 41,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 42,
    "endLine": 42,
    "event": "add"
  },
  {
    "code": "int256 newQuote = 0;",
    "startLine": 43,
    "endLine": 43,
    "event": "add"
  },
  {
    "code": "int256 newBase = 0;",
    "startLine": 44,
    "endLine": 44,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 45,
    "endLine": 45,
    "event": "add"
  },
  {
    "code": "if (trade.side == Perpetuals.Side.Long) {\n}",
    "startLine": 46,
    "endLine": 47,
    "event": "add"
  },
  {
    "code": "newBase = position.base + signedAmount;",
    "startLine": 47,
    "endLine": 47,
    "event": "add"
  },
  {
    "code": "newQuote = position.quote - quoteChange + fee;",
    "startLine": 48,
    "endLine": 48,
    "event": "add"
  },
  {
    "code": "} else if (trade.side == Perpetuals.Side.Short) {\n}",
    "startLine": 49,
    "endLine": 50,
    "event": "add"
  },
  {
    "code": "newBase = position.base - signedAmount;",
    "startLine": 50,
    "endLine": 50,
    "event": "add"
  },
  {
    "code": "newQuote = position.quote + quoteChange - fee;",
    "startLine": 51,
    "endLine": 51,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 53,
    "endLine": 53,
    "event": "add"
  },
  {
    "code": "Position memory newPosition = Position(newQuote, newBase);",
    "startLine": 54,
    "endLine": 54,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 55,
    "endLine": 55,
    "event": "add"
  },
  {
    "code": "return newPosition;",
    "startLine": 56,
    "endLine": 56,
    "event": "add"
  },

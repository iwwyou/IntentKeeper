  {
    "code": "function _calculatePrincipalWithdrawable(uint256 _id, address _lender) private view returns (uint256) {\n}",
    "startLine": 42,
    "endLine": 43,
    "event": "add"
  },
  {
    "code": "uint256 _borrowedTokens = pooledCLConstants[_id].borrowLimit;",
    "startLine": 43,

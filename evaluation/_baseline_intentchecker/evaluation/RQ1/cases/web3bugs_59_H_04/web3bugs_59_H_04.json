  {
    "code": "contract AuctionBurnReserveSkew {\n}",
    "startLine": 3,
    "endLine": 4,
    "event": "add"
  },
  {
    "code": "uint256[] public pegObservations;",
    "startLine": 4,
    "endLine": 4,
    "event": "add"
  },
  {
    "code": "uint256 public auctionAverageLookback = 10;",
    "startLine": 5,
    "endLine": 5,
    "event": "add"
  },
  {
    "code": "uint256 public count;",
    "startLine": 6,
    "endLine": 6,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 7,
    "endLine": 7,
    "event": "add"
  },
  {
    "code": "function _getIndexOfObservation(uint _index) internal view returns (uint index) {\n}",
    "startLine": 8,
    "endLine": 9,
    "event": "add"
  },
  {
    "code": "return _index % auctionAverageLookback;",
    "startLine": 9,
    "endLine": 9,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 11,
    "endLine": 11,
    "event": "add"
  },
  {
    "code": "function getPegDeltaFrequency() public view returns (uint256) {\n}",
    "startLine": 12,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "uint256 initialIndex = 0;",
    "startLine": 13,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "uint256 index;",
    "startLine": 14,
    "endLine": 14,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 15,
    "endLine": 15,
    "event": "add"
  },
  {
    "code": "if (count > auctionAverageLookback) {\n}",
    "startLine": 16,
    "endLine": 17,
    "event": "add"
  },
  {
    "code": "initialIndex = count - auctionAverageLookback;",
    "startLine": 17,
    "endLine": 17,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 19,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "uint256 total = 0;",
    "startLine": 20,
    "endLine": 20,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 21,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "for (uint256 i = initialIndex; i < count; ++i) {\n}",
    "startLine": 22,
    "endLine": 23,
    "event": "add"
  },
  {
    "code": "index = _getIndexOfObservation(i);",
    "startLine": 23,
    "endLine": 23,
    "event": "add"
  },
  {
    "code": "total = total + pegObservations[index];",
    "startLine": 24,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 26,
    "endLine": 26,
    "event": "add"
  },
  {
    "code": "return total * 10000 / auctionAverageLookback;",
    "startLine": 27,
    "endLine": 27,
    "event": "add"
  },
  {
    "code": "// @Post returnExpression == total * 10000 / (count - initialIndex)",
    "startLine": 28,
    "endLine": 28,
    "event": "add"
  },

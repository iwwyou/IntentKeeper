  {
    "code": "contract Basket is ERC20Upgradeable {\n}",
    "startLine": 3,
    "endLine": 4,
    "event": "add"
  },
  {
    "code": "uint256 public constant ONE_YEAR = 365.25 days;",
    "startLine": 4,
    "endLine": 4,
    "event": "add"
  },
  {
    "code": "uint256 private constant BASE = 1e18;",
    "startLine": 5,
    "endLine": 5,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 6,
    "endLine": 6,
    "event": "add"
  },
  {
    "code": "address public publisher;",
    "startLine": 7,
    "endLine": 7,
    "event": "add"
  },
  {
    "code": "uint256 public licenseFee;",
    "startLine": 8,
    "endLine": 8,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 9,
    "endLine": 9,
    "event": "add"
  },
  {
    "code": "IFactory public factory;",
    "startLine": 10,
    "endLine": 10,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 11,
    "endLine": 11,
    "event": "add"
  },
  {
    "code": "uint256 public ibRatio;",
    "startLine": 12,
    "endLine": 12,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 13,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "uint256 public lastFee;",
    "startLine": 14,
    "endLine": 14,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 15,
    "endLine": 15,
    "event": "add"
  },
  {
    "code": "event NewIBRatio(uint256 ibRatio);",
    "startLine": 16,
    "endLine": 16,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 17,
    "endLine": 17,
    "event": "add"
  },
  {
    "code": "function handleFees(uint256 startSupply) private {\n}",
    "startLine": 18,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "if (lastFee == 0) {\n}",
    "startLine": 19,
    "endLine": 20,
    "event": "add"
  },
  {
    "code": "lastFee = block.timestamp;",
    "startLine": 20,
    "endLine": 20,
    "event": "add"
  },
  {
    "code": "else if (startSupply == 0) {\n}",
    "startLine": 21,
    "endLine": 22,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "return;",
    "startLine": 22,
    "endLine": 22,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 23,
    "endLine": 24,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "uint256 timeDiff = (block.timestamp - lastFee);",
    "startLine": 24,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "uint256 feePct = timeDiff * licenseFee / ONE_YEAR;",
    "startLine": 25,
    "endLine": 25,
    "event": "add"
  },
  {
    "code": "uint256 fee = startSupply * feePct / (BASE - feePct);",
    "startLine": 26,
    "endLine": 26,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 27,
    "endLine": 27,
    "event": "add"
  },
  {
    "code": "_mint(publisher, fee * (BASE - factory.ownerSplit()) / BASE);",
    "startLine": 28,
    "endLine": 28,
    "event": "add"
  },
  {
    "code": "_mint(Ownable(address(factory)).owner(), fee * factory.ownerSplit() / BASE);",
    "startLine": 29,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "lastFee = block.timestamp;",
    "startLine": 30,
    "endLine": 30,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 31,
    "endLine": 31,
    "event": "add"
  },
  {
    "code": "uint256 newIbRatio = ibRatio * startSupply / totalSupply();",
    "startLine": 32,
    "endLine": 32,
    "event": "add"
  },
  {
    "code": "ibRatio = newIbRatio;",
    "startLine": 33,
    "endLine": 33,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 34,
    "endLine": 34,
    "event": "add"
  },
  {
    "code": "emit NewIBRatio(ibRatio);",
    "startLine": 35,
    "endLine": 35,
    "event": "add"
  },

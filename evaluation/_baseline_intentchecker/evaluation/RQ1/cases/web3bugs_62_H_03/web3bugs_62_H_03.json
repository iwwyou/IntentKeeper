  {
    "code": "unlocked = 1;",
    "startLine": 44,
    "endLine": 44,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 46,
    "endLine": 46,
    "event": "add"
  },
  {
    "code": "function lastApplicableTime() internal view returns (uint32) {\n}",
    "startLine": 47,
    "endLine": 48,
    "event": "add"
  },
  {
    "code": "return block.timestamp <= endStream ? uint32(block.timestamp) : endStream;",
    "startLine": 48,
    "endLine": 48,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 50,
    "endLine": 50,
    "event": "add"
  },
  {
    "code": "function rewardPerToken() public view returns (uint256) {\n}",
    "startLine": 51,
    "endLine": 52,
    "event": "add"
  },
  {
    "code": "if (totalVirtualBalance == 0) {\n}",
    "startLine": 52,
    "endLine": 53,
    "event": "add"
  },
  {
    "code": "return cumulativeRewardPerToken;",
    "startLine": 53,
    "endLine": 53,
    "event": "add"
  },
  {
    "code": "else {\n}",
    "startLine": 54,
    "endLine": 55,
    "event": "add",
    "closeBefore": true
  },
  {
    "code": "return cumulativeRewardPerToken + ( ((uint256(lastApplicableTime()) - lastUpdate) * rewardTokenAmount * depositDecimalsOne/streamDuration) / totalVirtualBalance );",
    "startLine": 55,
    "endLine": 58,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 61,
    "endLine": 61,
    "event": "add"
  },
  {
    "code": "function earned(TokenStream storage ts, uint256 currCumRewardPerToken) internal view returns (uint112) {\n}",
    "startLine": 62,
    "endLine": 63,
    "event": "add"
  },
  {
    "code": "return uint112(ts.virtualBalance * (currCumRewardPerToken - ts.lastCumulativeRewardPerToken) / depositDecimalsOne) + ts.rewards;",
    "startLine": 63,
    "endLine": 63,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 65,
    "endLine": 65,
    "event": "add"
  },
  {
    "code": "function claimReward() public lock {\n}",
    "startLine": 66,
    "endLine": 67,
    "event": "add"
  },
  {
    "code": "require(block.timestamp > endRewardLock, \"lock\");",
    "startLine": 67,
    "endLine": 67,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 68,
    "endLine": 68,
    "event": "add"
  },
  {
    "code": "TokenStream storage ts = tokensNotYetStreamed[msg.sender];",
    "startLine": 69,
    "endLine": 69,
    "event": "add"
  },
  {
    "code": "cumulativeRewardPerToken = rewardPerToken();",
    "startLine": 70,
    "endLine": 70,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 71,
    "endLine": 71,
    "event": "add"
  },
  {
    "code": "ts.rewards = earned(ts, cumulativeRewardPerToken);",
    "startLine": 72,
    "endLine": 72,
    "event": "add"
  },
  {
    "code": "ts.lastCumulativeRewardPerToken = cumulativeRewardPerToken;",
    "startLine": 73,
    "endLine": 73,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 74,
    "endLine": 74,
    "event": "add"
  },
  {
    "code": "lastUpdate = lastApplicableTime();",
    "startLine": 75,
    "endLine": 75,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 76,
    "endLine": 76,
    "event": "add"
  },
  {
    "code": "uint256 rewardAmt = ts.rewards;",
    "startLine": 77,
    "endLine": 77,
    "event": "add"
  },
  {
    "code": "ts.rewards = 0;",
    "startLine": 78,
    "endLine": 78,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 79,
    "endLine": 79,
    "event": "add"
  },
  {
    "code": "require(rewardAmt > 0, \"amt\");",
    "startLine": 80,
    "endLine": 80,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 81,
    "endLine": 81,
    "event": "add"
  },
  {
    "code": "ERC20(rewardToken).safeTransfer(msg.sender, rewardAmt);",
    "startLine": 82,
    "endLine": 82,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 83,
    "endLine": 83,
    "event": "add"
  },
  {

  },
  {
    "code": "\n",
    "startLine": 36,
    "endLine": 36,
    "event": "add"
  },
  {
    "code": "function lockInternal() internal {\n}",
    "startLine": 37,
    "endLine": 38,
    "event": "add"
  },
  {
    "code": "require(unlocked == 1, \"re\");",
    "startLine": 38,
    "endLine": 38,
    "event": "add"
  },
  {
    "code": "unlocked = 2;",
    "startLine": 39,
    "endLine": 39,
    "event": "add"
  },
  {
    "code": "modifier lock {\n}",
    "startLine": 41,

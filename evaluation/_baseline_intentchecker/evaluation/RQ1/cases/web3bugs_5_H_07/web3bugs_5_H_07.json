  {
    "code": "function calcAsymmetricShare(uint u, uint U, uint A) public pure returns (uint){\n}",
    "startLine": 17,
    "endLine": 18,
    "event": "add"
  },
  {
    "code": "uint part1 = (u * A);",
    "startLine": 18,
    "endLine": 18,
    "event": "add"
  },
  {
    "code": "uint part2 = ((U * U) * 2);",
    "startLine": 19,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "uint part3 = ((U * u) * 2);",
    "startLine": 20,
    "endLine": 20,
    "event": "add"
  },
  {
    "code": "uint part4 = (u * u);",
    "startLine": 21,
    "endLine": 21,
    "event": "add"
  },
  {
    "code": "uint numerator = ((part1 * part2) - part3) + part4;",
    "startLine": 22,
    "endLine": 22,
    "event": "add"
  },
  {
    "code": "uint part5 = ((U * U) * U);",
    "startLine": 23,
    "endLine": 23,
    "event": "add"
  },
  {
    "code": "return (numerator / part5);",
    "startLine": 24,
    "endLine": 24,
    "event": "add"
  },

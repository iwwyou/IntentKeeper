  {
    "code": "function swapAndLiquify(uint256 contractTokenBalance) private lockTheSwap {\n}",
    "startLine": 138,
    "endLine": 139,
    "event": "add"
  },
  {
    "code": "uint256 toMarketing = contractTokenBalance.mul(_marketingFee).div(_marketingFee.add(_liquidityFee));",

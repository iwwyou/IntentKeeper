    "startLine": 12,
    "endLine": 12,
    "event": "add"
  },
  {
    "code": "uint256 price0CumulativeLast;",
    "startLine": 13,
    "endLine": 13,
    "event": "add"
  },
  {
    "code": "uint256 price1CumulativeLast;",
    "startLine": 14,
    "endLine": 14,
    "event": "add"
  },
  {
    "code": "uint32 blockTimestampLast;",
    "startLine": 15,
    "endLine": 15,
    "event": "add"
  },
  {

    "event": "add"
  },
  {
    "code": "function consult(address token) public view returns (uint256 result) {\n}",
    "startLine": 23,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "uint256 pairCount = _pairs.length;",
    "startLine": 24,
    "endLine": 24,
    "event": "add"
  },
  {
    "code": "uint256 sumNative = 0;",
    "startLine": 25,
    "endLine": 25,
    "event": "add"
  },
  {
    "code": "uint256 sumUSD = 0;",
    "startLine": 26,
    "endLine": 26,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 27,
    "endLine": 27,
    "event": "add"
  },
  {
    "code": "for (uint256 i = 0; i < pairCount; i++) {\n}",
    "startLine": 28,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "PairData memory pairData = _pairs[i];",
    "startLine": 29,
    "endLine": 29,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 30,
    "endLine": 30,
    "event": "add"
  },
  {
    "code": "if (token == pairData.token0) {\n}",
    "startLine": 31,
    "endLine": 32,
    "event": "add"
  },
  {
    "code": "sumNative += pairData.price1Average.mul(1).decode144();",
    "startLine": 32,
    "endLine": 32,
    "event": "add"
  },
  {
    "code": "if (pairData.price1Average._x != 0) {\n}",
    "startLine": 33,
    "endLine": 34,
    "event": "add"
  },
  {
    "code": "require(sumNative != 0);",
    "startLine": 34,
    "endLine": 34,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 36,
    "endLine": 36,
    "event": "add"
  },
  {
    "code": "( uint80 roundID, int256 price, , , uint80 answeredInRound ) = AggregatorV3Interface(_aggregators[pairData.token1]) .latestRoundData();",
    "startLine": 37,
    "endLine": 44,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 45,
    "endLine": 45,
    "event": "add"
  },
  {
    "code": "require( answeredInRound >= roundID, \"TwapOracle::consult: stale chainlink price\" );",
    "startLine": 46,
    "endLine": 49,
    "event": "add"
  },
  {
    "code": "require( price != 0, \"TwapOracle::consult: chainlink malfunction\" );",
    "startLine": 50,
    "endLine": 53,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 54,
    "endLine": 54,
    "event": "add"
  },
  {
    "code": "sumUSD += uint256(price) * (10**10);",
    "startLine": 55,
    "endLine": 55,
    "event": "add"
  },
  {
    "code": "require(sumNative != 0, \"TwapOracle::consult: Sum of native is zero\");",
    "startLine": 58,
    "endLine": 58,
    "event": "add"
  },
  {
    "code": "result = ((sumUSD * IERC20Metadata(token).decimals()) / sumNative);",
    "startLine": 59,
    "endLine": 59,
    "event": "add"
  },
  {
    "code": "// @Post result == (sumUSD * (10 ** 18)) / sumNative",
    "startLine": 60,
    "endLine": 60,
    "event": "add"
  },

  },
  {
    "code": "FixedPoint.uq112x112 price1Average;",
    "startLine": 17,
    "endLine": 17,
    "event": "add"
  },
  {
    "code": "\n",
    "startLine": 19,
    "endLine": 19,
    "event": "add"
  },
  {
    "code": "mapping(address => address) private _aggregators;",

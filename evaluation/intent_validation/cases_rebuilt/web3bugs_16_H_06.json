 {
  "code": "function latestAnswer() external view override returns (uint256) {\n}",
  "startLine": 10,
  "endLine": 11,
  "event": "add"
 },
 {
  "code": "uint256 gasPrice = uint256(gasOracle.latestAnswer());",
  "startLine": 11,
  "endLine": 11,
  "event": "add"
 },
 {
  "code": "uint256 ethPrice = uint256(priceOracle.latestAnswer());",
  "startLine": 12,
  "endLine": 12,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 13,
  "endLine": 13,
  "event": "add"
 },
 {
  "code": "uint256 result = PRBMathUD60x18.mul(gasPrice, ethPrice);",
  "startLine": 14,
  "endLine": 14,
  "event": "add"
 },
 {
  "code": "return result;",
  "startLine": 15,
  "endLine": 15,
  "event": "add"

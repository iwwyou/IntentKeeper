 {
  "code": "function checkIsOverdue(address account) public view returns (bool isOverdue) {\n}",
  "startLine": 58,
  "endLine": 59,
  "event": "add"
 },
 {
  "code": "if (getBorrowed(account) == 0) {\n}",
  "startLine": 59,
  "endLine": 60,
  "event": "add"
 },
 {
  "code": "isOverdue = false;",

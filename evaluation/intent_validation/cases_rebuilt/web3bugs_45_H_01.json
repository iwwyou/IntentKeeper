 },
 {
  "code": "return 0;",
  "startLine": 101,
  "endLine": 101,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 103,
  "endLine": 103,
  "event": "add"
 },
 {
  "code": "uint256 borrowRate = borrowRatePerBlock();",
  "startLine": 104,
  "endLine": 104,
  "event": "add"
 },
 {
  "code": "uint256 currentBlockNumber = getBlockNumber();",
  "startLine": 105,
  "endLine": 105,
  "event": "add"
 },
 {
  "code": "uint256 blockDelta = currentBlockNumber - accrualBlockNumber;",
  "startLine": 106,
  "endLine": 106,
  "event": "add"
 },
 {
  "code": "uint256 simpleInterestFactor = borrowRate * blockDelta;",

  "endLine": 120,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 121,
  "endLine": 121,
  "event": "add"
 },
 {
  "code": "uint256 fee = calculatingFee(amount);",
  "startLine": 122,
  "endLine": 122,
  "event": "add"
 },
 {
  "code": "require(borrowBalanceView(msg.sender) + amount + fee <= maxBorrow, \"UToken: amount large than borrow size max\");",
  "startLine": 123,
  "endLine": 123,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 124,
  "endLine": 124,
  "event": "add"
 },
 {
  "code": "require(!checkIsOverdue(msg.sender), \"UToken: Member has loans overdue\");",
  "startLine": 125,
  "endLine": 125,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 126,
  "endLine": 126,
  "event": "add"
 },
 {
  "code": "require(amount <= assetManagerContract.getLoanableAmount(underlying), \"UToken: Not enough to lend out\");",
  "startLine": 127,
  "endLine": 127,
  "event": "add"
 },
 {
  "code": "require(uint256(_getCreditLimit(msg.sender)) >= amount + fee, \"UToken: The loan amount plus fee is greater than credit limit\");",
  "startLine": 128,
  "endLine": 128,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 129,
  "endLine": 129,
  "event": "add"
 },
 {
  "code": "require(accrueInterest(), \"UToken: accrue interest failed\");",
  "startLine": 130,
  "endLine": 130,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 131,
  "endLine": 131,
  "event": "add"
 },
 {
  "code": "uint256 borrowedAmount = borrowBalanceStoredInternal(msg.sender);",
  "startLine": 132,
  "endLine": 132,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 133,
  "endLine": 133,
  "event": "add"
 },
 {
  "code": "if (accountBorrows[msg.sender].lastRepay == 0) {\n}",
  "startLine": 134,
  "endLine": 135,
  "event": "add"
 },
 {
  "code": "accountBorrows[msg.sender].lastRepay = getBlockNumber();",
  "startLine": 135,
  "endLine": 135,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 137,
  "endLine": 137,
  "event": "add"
 },
 {
  "code": "uint256 accountBorrowsNew = borrowedAmount + amount + fee;",
  "startLine": 138,
  "endLine": 138,
  "event": "add"
 },
 {
  "code": "uint256 totalBorrowsNew = totalBorrows + amount + fee;",
  "startLine": 139,
  "endLine": 139,
  "event": "add"
 },
 {
  "code": "uint256 oldPrincipal = accountBorrows[msg.sender].principal;",
  "startLine": 140,
  "endLine": 140,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 141,
  "endLine": 141,
  "event": "add"
 },
 {
  "code": "accountBorrows[msg.sender].principal += amount + fee;",
  "startLine": 142,
  "endLine": 142,
  "event": "add"
 },
 {
  "code": "uint256 newPrincipal = accountBorrows[msg.sender].principal;",
  "startLine": 143,
  "endLine": 143,
  "event": "add"
 },
 {
  "code": "IUserManager(userManager).updateLockedData(msg.sender, newPrincipal - oldPrincipal, true);",
  "startLine": 144,
  "endLine": 144,
  "event": "add"
 },
 {
  "code": "accountBorrows[msg.sender].interest = accountBorrowsNew - accountBorrows[msg.sender].principal;",
  "startLine": 145,
  "endLine": 145,
  "event": "add"
 },
 {
  "code": "accountBorrows[msg.sender].interestIndex = borrowIndex;",
  "startLine": 146,
  "endLine": 146,
  "event": "add"
 },
 {
  "code": "totalBorrows = totalBorrowsNew;",
  "startLine": 147,
  "endLine": 147,
  "event": "add"
 },
 {
  "code": "totalReserves += fee;",
  "startLine": 148,
  "endLine": 148,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 149,
  "endLine": 149,
  "event": "add"
 },
 {
  "code": "require(assetManagerContract.withdraw(underlying, msg.sender, amount), \"UToken: Failed to withdraw\");",
  "startLine": 150,
  "endLine": 150,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 151,
  "endLine": 151,
  "event": "add"
 },
 {
  "code": "emit LogBorrow(msg.sender, amount, fee);",
  "startLine": 152,
  "endLine": 152,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 154,
  "endLine": 154,
  "event": "add"
 },
 {
  "code": "function accrueInterest() public returns (bool) {\n}",
  "startLine": 155,
  "endLine": 156,
  "event": "add"
 },
 {
  "code": "uint256 borrowRate = borrowRatePerBlock();",
  "startLine": 156,
  "endLine": 156,
  "event": "add"
 },
 {
  "code": "uint256 currentBlockNumber = getBlockNumber();",
  "startLine": 157,
  "endLine": 157,
  "event": "add"
 },
 {
  "code": "uint256 blockDelta = currentBlockNumber - accrualBlockNumber;",
  "startLine": 158,
  "endLine": 158,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 159,
  "endLine": 159,
  "event": "add"
 },
 {
  "code": "uint256 simpleInterestFactor = borrowRate * blockDelta;",
  "startLine": 160,
  "endLine": 160,
  "event": "add"
 },
 {
  "code": "uint256 interestAccumulated = (simpleInterestFactor * totalBorrows) / WAD;",
  "startLine": 161,
  "endLine": 161,
  "event": "add"
 },
 {
  "code": "uint256 totalBorrowsNew = interestAccumulated + totalBorrows;",
  "startLine": 162,
  "endLine": 162,
  "event": "add"
 },
 {
  "code": "uint256 borrowIndexNew = (simpleInterestFactor * borrowIndex) / WAD + borrowIndex;",
  "startLine": 163,
  "endLine": 163,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 164,
  "endLine": 164,
  "event": "add"
 },
 {
  "code": "accrualBlockNumber = currentBlockNumber;",
  "startLine": 165,
  "endLine": 165,
  "event": "add"
 },
 {
  "code": "borrowIndex = borrowIndexNew;",
  "startLine": 166,
  "endLine": 166,
  "event": "add"
 },
 {
  "code": "totalBorrows = totalBorrowsNew;",
  "startLine": 167,
  "endLine": 167,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 168,
  "endLine": 168,
  "event": "add"
 },
 {
  "code": "return true;",
  "startLine": 169,
  "endLine": 169,
  "event": "add"
 },

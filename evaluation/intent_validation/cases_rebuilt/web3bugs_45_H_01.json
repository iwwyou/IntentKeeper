  "endLine": 108,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 109,
  "endLine": 109,
  "event": "add"
 },
 {
  "code": "uint256 principalTimesIndex = (loan.principal + loan.interest) * borrowIndexNew;",
  "startLine": 110,
  "endLine": 110,
  "event": "add"
 },
 {
  "code": "uint256 balance = principalTimesIndex / loan.interestIndex;",
  "startLine": 111,
  "endLine": 111,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 112,
  "endLine": 112,
  "event": "add"
 },
 {
  "code": "return balance - accountBorrows[account].principal;",
  "startLine": 113,
  "endLine": 113,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 115,
  "endLine": 115,
  "event": "add"
 },
 {
  "code": "function borrow(uint256 amount) external onlyMember(msg.sender) whenNotPaused nonReentrant {\n}",
  "startLine": 116,
  "endLine": 117,
  "event": "add"
 },
 {
  "code": "IAssetManager assetManagerContract = IAssetManager(assetManager);",
  "startLine": 117,
  "endLine": 117,
  "event": "add"
 },
 {
  "code": "require(amount >= minBorrow, \"UToken: amount less than loan size min\");",
  "startLine": 118,
  "endLine": 118,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 119,
  "endLine": 119,
  "event": "add"
 },
 {
  "code": "require(amount <= getRemainingLoanSize(), \"UToken: amount more than loan global size max\");",

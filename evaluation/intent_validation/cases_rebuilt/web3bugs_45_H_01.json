 {
  "code": "function calculatingInterest(address account) public view returns (uint256) {\n}",
  "startLine": 97,
  "endLine": 98,
  "event": "add"
 },
 {
  "code": "BorrowSnapshot memory loan = accountBorrows[account];",
  "startLine": 98,
  "endLine": 98,

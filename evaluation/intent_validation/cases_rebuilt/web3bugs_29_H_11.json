 {
  "code": "function _getAmountOut(uint256 amountIn, uint256 reserveAmountIn, uint256 reserveAmountOut) internal view returns (uint256 amountOut) {\n}",
  "startLine": 127,
  "endLine": 128,
  "event": "add"
 },
 {
  "code": "uint256 amountInWithFee = amountIn * MAX_FEE_MINUS_SWAP_FEE;",
  "startLine": 128,
  "endLine": 128,
  "event": "add"
 },
 {
  "code": "amountOut = (amountInWithFee * reserveAmountOut) / (reserveAmountIn * MAX_FEE + amountInWithFee);",
  "startLine": 129,
  "endLine": 129,
  "event": "add"
 },

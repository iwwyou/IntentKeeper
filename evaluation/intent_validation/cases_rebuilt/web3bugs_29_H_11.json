 {
  "code": "function _mintFee(uint112 _reserve0, uint112 _reserve1, uint256 _totalSupply) internal returns (uint256 liquidity) {\n}",
  "startLine": 114,
  "endLine": 115,
  "event": "add"
 },
 {
  "code": "uint256 _kLast = kLast;",
  "startLine": 115,
  "endLine": 115,
  "event": "add"
 },
 {
  "code": "if (_kLast != 0) {\n}",
  "startLine": 116,
  "endLine": 117,
  "event": "add"
 },
 {
  "code": "uint256 computed = TridentMath.sqrt(uint256(_reserve0) * _reserve1);",
  "startLine": 117,
  "endLine": 117,
  "event": "add"
 },
 {
  "code": "if (computed > _kLast) {\n}",
  "startLine": 118,
  "endLine": 119,
  "event": "add"
 },
 {
  "code": "liquidity = (_totalSupply * (computed - _kLast) * barFee) / computed / MAX_FEE;",
  "startLine": 119,
  "endLine": 119,
  "event": "add"
 },
 {
  "code": "if (liquidity != 0) {\n}",
  "startLine": 120,
  "endLine": 121,
  "event": "add"
 },
 {
  "code": "_mint(barFeeTo, liquidity);",
  "startLine": 121,
  "endLine": 121,
  "event": "add"
 },

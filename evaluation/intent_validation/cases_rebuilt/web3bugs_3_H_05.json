  "code": "function sumTokensInPegWithYield(address[] storage tokens, mapping(address => uint256) storage amounts, mapping(address => uint256) storage yieldQuotientsFP, bool forceCurBlock) internal returns (uint256 totalPeg) {\n}",
  "startLine": 46,

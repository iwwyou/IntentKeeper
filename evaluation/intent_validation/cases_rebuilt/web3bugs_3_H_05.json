 {
  "code": "function yieldTokenInPeg(address token, uint256 amount, mapping(address => uint256) storage yieldQuotientsFP, bool forceCurBlock) internal returns (uint256) {\n}",
  "startLine": 54,
  "endLine": 55,
  "event": "add"
 },
 {
  "code": "uint256 yieldFP = Lending(lending()).viewBorrowingYieldFP(token);",
  "startLine": 55,
  "endLine": 55,
  "event": "add"
 },
 {
  "code": "uint256 amountInToken = (amount * yieldFP) / yieldQuotientsFP[token];",

 },
 {
  "code": "function _chargeFees(uint256 thisNft, uint256[] memory tvls, uint256 supply, uint256[] memory deltaTvls, uint256 deltaSupply, bool isWithdraw) internal {\n}",
  "startLine": 15,
  "endLine": 16,
  "event": "add"
 },
 {
  "code": "ILpIssuerGovernance vg = ILpIssuerGovernance(address(_vaultGovernance));",
  "startLine": 16,
  "endLine": 16,
  "event": "add"
 },
 {
  "code": "uint256 elapsed = block.timestamp - lastFeeCharge;",
  "startLine": 17,
  "endLine": 17,
  "event": "add"
 },
 {
  "code": "if (elapsed < vg.delayedProtocolParams().managementFeeChargeDelay) {\n}",
  "startLine": 18,
  "endLine": 19,
  "event": "add"
 },
 {
  "code": "return;",
  "startLine": 19,
  "endLine": 19,
  "event": "add"
 },
 {
  "code": "lastFeeCharge = block.timestamp;",
  "startLine": 21,
  "endLine": 21,
  "event": "add"
 },
 {
  "code": "uint256 baseSupply = supply;",
  "startLine": 22,
  "endLine": 22,
  "event": "add"
 },
 {
  "code": "if (isWithdraw) {\n}",
  "startLine": 23,
  "endLine": 24,
  "event": "add"
 },
 {
  "code": "baseSupply = 0;",
  "startLine": 24,
  "endLine": 24,
  "event": "add"
 },
 {
  "code": "if (supply > deltaSupply) {\n}",
  "startLine": 25,
  "endLine": 26,
  "event": "add"
 },
 {
  "code": "baseSupply = supply - deltaSupply;",
  "startLine": 26,
  "endLine": 26,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 29,
  "endLine": 29,
  "event": "add"
 },
 {
  "code": "if (baseSupply == 0) {\n}",
  "startLine": 30,
  "endLine": 31,
  "event": "add"
 },
 {
  "code": "for (uint256 i = 0; i < tvls.length; i++) {\n}",
  "startLine": 31,
  "endLine": 32,
  "event": "add"
 },
 {
  "code": "_lpPriceHighWaterMarks[i] = (deltaTvls[i] * CommonLibrary.PRICE_DENOMINATOR) / deltaSupply;",
  "startLine": 32,
  "endLine": 32,
  "event": "add"
 },
 {
  "code": "return;",
  "startLine": 34,
  "endLine": 34,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 36,
  "endLine": 36,
  "event": "add"
 },
 {
  "code": "uint256[] memory baseTvls = new uint256[](tvls.length);",
  "startLine": 37,
  "endLine": 37,
  "event": "add"
 },
 {
  "code": "for (uint256 i = 0; i < baseTvls.length; i++) {\n}",
  "startLine": 38,
  "endLine": 39,
  "event": "add"
 },
 {
  "code": "if (isWithdraw) {\n}",
  "startLine": 39,
  "endLine": 40,
  "event": "add"
 },
 {
  "code": "baseTvls[i] = tvls[i] - deltaTvls[i];",
  "startLine": 40,
  "endLine": 40,
  "event": "add"
 },
 {
  "code": "else {\n}",
  "startLine": 41,
  "endLine": 42,
  "event": "add",
  "closeBefore": true
 },
 {
  "code": "baseTvls[i] = tvls[i];",
  "startLine": 42,
  "endLine": 42,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 45,
  "endLine": 45,
  "event": "add"
 },
 {
  "code": "ILpIssuerGovernance.DelayedStrategyParams memory strategyParams = vg.delayedStrategyParams(thisNft);",
  "startLine": 46,
  "endLine": 46,
  "event": "add"
 },
 {
  "code": "if (strategyParams.managementFee > 0) {\n}",
  "startLine": 47,
  "endLine": 48,
  "event": "add"
 },
 {
  "code": "uint256 toMint = (strategyParams.managementFee * baseSupply * elapsed) / (CommonLibrary.DENOMINATOR * CommonLibrary.YEAR);",
  "startLine": 48,
  "endLine": 48,
  "event": "add"
 },
 {
  "code": "_mint(strategyParams.strategyTreasury, toMint);",
  "startLine": 49,
  "endLine": 49,
  "event": "add"
 },
 {
  "code": "emit ManagementFeesCharged(strategyParams.strategyTreasury, strategyParams.managementFee, toMint);",
  "startLine": 50,
  "endLine": 50,
  "event": "add"
 },
 {
  "code": "uint256 protocolFee = vg.delayedProtocolPerVaultParams(thisNft).protocolFee;",
  "startLine": 52,
  "endLine": 52,
  "event": "add"
 },
 {
  "code": "if (protocolFee > 0) {\n}",
  "startLine": 53,
  "endLine": 54,
  "event": "add"
 },
 {
  "code": "address treasury = vg.internalParams().protocolGovernance.protocolTreasury();",
  "startLine": 54,
  "endLine": 54,
  "event": "add"
 },
 {
  "code": "uint256 toMint = (protocolFee * baseSupply * elapsed) / (CommonLibrary.DENOMINATOR * CommonLibrary.YEAR);",
  "startLine": 55,
  "endLine": 55,
  "event": "add"
 },
 {
  "code": "_mint(treasury, toMint);",
  "startLine": 56,
  "endLine": 56,
  "event": "add"
 },
 {
  "code": "emit ProtocolFeesCharged(treasury, protocolFee, toMint);",
  "startLine": 57,
  "endLine": 57,
  "event": "add"
 },
 {
  "code": "uint256 performanceFee = strategyParams.performanceFee;",
  "startLine": 59,
  "endLine": 59,
  "event": "add"
 },
 {
  "code": "uint256[] memory hwms = _lpPriceHighWaterMarks;",
  "startLine": 60,
  "endLine": 60,
  "event": "add"
 },
 {
  "code": "if (performanceFee > 0) {\n}",
  "startLine": 61,
  "endLine": 62,
  "event": "add"
 },
 {
  "code": "uint256 minLpPriceFactor = type(uint256).max;",
  "startLine": 62,
  "endLine": 62,
  "event": "add"
 },
 {
  "code": "for (uint256 i = 0; i < baseTvls.length; i++) {\n}",
  "startLine": 63,
  "endLine": 64,
  "event": "add"
 },
 {
  "code": "uint256 hwm = hwms[i];",
  "startLine": 64,
  "endLine": 64,
  "event": "add"
 },
 {
  "code": "uint256 lpPrice = (baseTvls[i] * CommonLibrary.PRICE_DENOMINATOR) / baseSupply;",
  "startLine": 65,
  "endLine": 65,
  "event": "add"
 },
 {
  "code": "if (lpPrice > hwm) {\n}",
  "startLine": 66,
  "endLine": 67,
  "event": "add"
 },
 {
  "code": "uint256 delta = (lpPrice * CommonLibrary.DENOMINATOR) / hwm;",
  "startLine": 67,
  "endLine": 67,
  "event": "add"
 },
 {
  "code": "if (delta < minLpPriceFactor) {\n}",
  "startLine": 68,
  "endLine": 69,
  "event": "add"
 },
 {
  "code": "minLpPriceFactor = delta;",
  "startLine": 69,
  "endLine": 69,
  "event": "add"
 },
 {
  "code": "else {\n}",
  "startLine": 71,
  "endLine": 72,
  "event": "add",
  "closeBefore": true
 },
 {
  "code": "return;",
  "startLine": 72,
  "endLine": 72,
  "event": "add"
 },
 {
  "code": "for (uint256 i = 0; i < tvls.length; i++) {\n}",
  "startLine": 75,
  "endLine": 76,
  "event": "add"
 },
 {
  "code": "_lpPriceHighWaterMarks[i] += (hwms[i] * minLpPriceFactor) / CommonLibrary.DENOMINATOR;",
  "startLine": 76,
  "endLine": 76,
  "event": "add"
 },
 {
  "code": "address treasury = strategyParams.strategyPerformanceTreasury;",
  "startLine": 78,
  "endLine": 78,
  "event": "add"
 },
 {
  "code": "uint256 toMint = (baseSupply * minLpPriceFactor) / CommonLibrary.DENOMINATOR;",
  "startLine": 79,
  "endLine": 79,
  "event": "add"
 },
 {
  "code": "_mint(treasury, toMint);",
  "startLine": 80,
  "endLine": 80,
  "event": "add"
 },
 {
  "code": "emit PerformanceFeesCharged(treasury, performanceFee, toMint);",
  "startLine": 81,
  "endLine": 81,
  "event": "add"
 },

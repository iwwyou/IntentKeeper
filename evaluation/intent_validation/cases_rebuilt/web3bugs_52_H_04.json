 },
 {
  "code": "uint256 sumNative = 0;",
  "startLine": 36,
  "endLine": 36,
  "event": "add"
 },
 {
  "code": "uint256 sumUSD = 0;",
  "startLine": 37,
  "endLine": 37,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 38,
  "endLine": 38,
  "event": "add"
 },
 {
  "code": "for (uint256 i = 0; i < pairCount; i++) {\n}",
  "startLine": 39,
  "endLine": 40,
  "event": "add"
 },
 {
  "code": "PairData memory pairData = _pairs[i];",
  "startLine": 40,
  "endLine": 40,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 41,
  "endLine": 41,
  "event": "add"
 },
 {
  "code": "if (token == pairData.token0) {\n}",
  "startLine": 42,
  "endLine": 43,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 43,
  "endLine": 43,
  "event": "add"
 },
 {
  "code": "sumNative += pairData.price1Average.mul(1).decode144();",
  "startLine": 44,
  "endLine": 44,
  "event": "add"
 },
 {
  "code": "if (pairData.price1Average._x != 0) {\n}",
  "startLine": 45,
  "endLine": 46,
  "event": "add"
 },
 {
  "code": "require(sumNative != 0);",
  "startLine": 46,
  "endLine": 46,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 48,
  "endLine": 48,
  "event": "add"
 },
 {
  "code": "(uint80 roundID, int256 price,,, uint80 answeredInRound) = AggregatorV3Interface(_aggregators[pairData.token1]).latestRoundData();",
  "startLine": 49,
  "endLine": 49,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 50,
  "endLine": 50,
  "event": "add"
 },
 {
  "code": "require(answeredInRound >= roundID, \"TwapOracle::consult: stale chainlink price\");",
  "startLine": 51,
  "endLine": 51,
  "event": "add"
 },
 {
  "code": "require(price != 0, \"TwapOracle::consult: chainlink malfunction\");",
  "startLine": 52,
  "endLine": 52,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 53,
  "endLine": 53,
  "event": "add"
 },
 {
  "code": "sumUSD += uint256(price) * (10**10);",
  "startLine": 54,
  "endLine": 54,
  "event": "add"
 },
 {
  "code": "require(sumNative != 0, \"TwapOracle::consult: Sum of native is zero\");",
  "startLine": 57,
  "endLine": 57,
  "event": "add"
 },
 {
  "code": "result = ((sumUSD * IERC20Metadata(token).decimals()) / sumNative);",
  "startLine": 58,
  "endLine": 58,
  "event": "add"
 },
 {

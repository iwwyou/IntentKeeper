 {
  "code": "function _getTValues(uint256 tAmount, uint256 taxFee, uint256 teamFee) private pure returns (uint256, uint256, uint256) {\n}",
  "startLine": 411,
  "endLine": 412,
  "event": "add"
 },
 {
  "code": "uint256 tFee = tAmount.mul(taxFee).div(100);",
  "startLine": 412,
  "endLine": 412,
  "event": "add"
 },
 {
  "code": "uint256 tTeam = tAmount.mul(teamFee).div(100);",
  "startLine": 413,
  "endLine": 413,
  "event": "add"
 },
 {
  "code": "uint256 tTransferAmount = tAmount.sub(tFee).sub(tTeam);",
  "startLine": 414,
  "endLine": 414,
  "event": "add"
 },
 {
  "code": "return (tTransferAmount, tFee, tTeam);",

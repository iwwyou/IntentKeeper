 {
  "code": "function _getRValues(uint256 tAmount, uint256 tFee, uint256 tTeam, uint256 currentRate) private pure returns (uint256, uint256, uint256) {\n}",
  "startLine": 418,
  "endLine": 419,
  "event": "add"
 },
 {
  "code": "uint256 rAmount = tAmount.mul(currentRate);",
  "startLine": 419,
  "endLine": 419,
  "event": "add"
 },
 {
  "code": "uint256 rFee = tFee.mul(currentRate);",
  "startLine": 420,

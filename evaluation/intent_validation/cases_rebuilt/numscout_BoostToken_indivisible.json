  "event": "add"
 },
 {
  "code": "uint256 rTeam = tTeam.mul(currentRate);",
  "startLine": 421,
  "endLine": 421,
  "event": "add"
 },
 {
  "code": "uint256 rTransferAmount = rAmount.sub(rFee).sub(rTeam);",

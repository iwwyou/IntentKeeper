 {
  "code": "function _getCurrentSupply() private view returns(uint256, uint256) {\n}",
  "startLine": 431,
  "endLine": 432,
  "event": "add"
 },
 {
  "code": "uint256 rSupply = _rTotal;",
  "startLine": 432,
  "endLine": 432,
  "event": "add"
 },
 {
  "code": "uint256 tSupply = _tTotal;",
  "startLine": 433,
  "endLine": 433,
  "event": "add"
 },
 {
  "code": "for (uint256 i = 0; i < _excluded.length; i++) {\n}",
  "startLine": 434,
  "endLine": 435,
  "event": "add"
 },
 {
  "code": "if (_rOwned[_excluded[i]] > rSupply || _tOwned[_excluded[i]] > tSupply) {\n}",
  "startLine": 435,
  "endLine": 436,
  "event": "add"
 },
 {
  "code": "return (_rTotal, _tTotal);",
  "startLine": 436,
  "endLine": 436,
  "event": "add"
 },
 {
  "code": "rSupply = rSupply.sub(_rOwned[_excluded[i]]);",
  "startLine": 438,
  "endLine": 438,
  "event": "add"
 },
 {
  "code": "tSupply = tSupply.sub(_tOwned[_excluded[i]]);",
  "startLine": 439,
  "endLine": 439,
  "event": "add"
 },
 {
  "code": "if (rSupply < _rTotal.div(_tTotal)) {\n}",
  "startLine": 441,
  "endLine": 442,
  "event": "add"
 },
 {
  "code": "return (_rTotal, _tTotal);",
  "startLine": 442,
  "endLine": 442,
  "event": "add"
 },
 {
  "code": "return (rSupply, tSupply);",
  "startLine": 444,

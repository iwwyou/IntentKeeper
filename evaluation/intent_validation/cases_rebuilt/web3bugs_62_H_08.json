  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 91,
  "endLine": 91,
  "event": "add"
 },
 {
  "code": "ts.rewards = earned(ts, cumulativeRewardPerToken);",
  "startLine": 92,
  "endLine": 92,
  "event": "add"
 },
 {
  "code": "ts.lastCumulativeRewardPerToken = cumulativeRewardPerToken;",
  "startLine": 93,
  "endLine": 93,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 94,
  "endLine": 94,
  "event": "add"
 },
 {
  "code": "uint32 acctTimeDelta = uint32(block.timestamp) - ts.lastUpdate;",
  "startLine": 95,
  "endLine": 95,
  "event": "add"
 },
 {
  "code": "if (acctTimeDelta > 0 && ts.tokens > 0) {\n}",
  "startLine": 96,
  "endLine": 97,
  "event": "add"
 },
 {
  "code": "ts.tokens -= uint112(acctTimeDelta * ts.tokens / (endStream - ts.lastUpdate));",
  "startLine": 97,
  "endLine": 97,
  "event": "add"
 },
 {
  "code": "ts.lastUpdate = uint32(block.timestamp);",
  "startLine": 98,
  "endLine": 98,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 100,
  "endLine": 100,
  "event": "add"
 },
 {
  "code": "uint32 tdelta = uint32(block.timestamp - lastUpdate);",
  "startLine": 101,
  "endLine": 101,
  "event": "add"
 },
 {
  "code": "if (tdelta > 0 && unstreamed > 0) {\n}",
  "startLine": 102,
  "endLine": 103,
  "event": "add"
 },
 {
  "code": "uint256 globalStreamingSpeedPerSecond = (uint256(unstreamed) * 10**6)/ (endStream - lastUpdate);",
  "startLine": 103,
  "endLine": 103,
  "event": "add"
 },
 {
  "code": "unstreamed -= uint112((uint256(tdelta) * globalStreamingSpeedPerSecond) / 10**6);",
  "startLine": 104,
  "endLine": 104,
  "event": "add"
 },
 {
  "code": "lastUpdate = uint32(block.timestamp);",
  "startLine": 106,
  "endLine": 106,
  "event": "add"
 },
 {
  "code": "else {\n}",
  "startLine": 107,
  "endLine": 108,
  "event": "add",
  "closeBefore": true
 },
 {
  "code": "if (ts.lastUpdate == 0) {\n}",
  "startLine": 108,
  "endLine": 109,
  "event": "add"
 },
 {
  "code": "ts.lastUpdate = startTime;",
  "startLine": 109,
  "endLine": 109,
  "event": "add"
 },
 {
  "code": "if (lastUpdate == 0) {\n}",
  "startLine": 111,
  "endLine": 112,
  "event": "add"
 },
 {
  "code": "lastUpdate = startTime;",
  "startLine": 112,
  "endLine": 112,
  "event": "add"

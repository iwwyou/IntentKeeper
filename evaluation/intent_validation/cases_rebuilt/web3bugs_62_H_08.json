  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 81,
  "endLine": 81,
  "event": "add"
 },
 {
  "code": "if (block.timestamp >= startTime) {\n}",
  "startLine": 82,
  "endLine": 83,
  "event": "add"
 },
 {
  "code": "if (ts.lastUpdate == 0) {\n}",
  "startLine": 83,
  "endLine": 84,
  "event": "add"
 },
 {
  "code": "ts.lastUpdate = uint32(block.timestamp);",
  "startLine": 84,
  "endLine": 84,
  "event": "add"
 },
 {
  "code": "if (lastUpdate == 0) {\n}",
  "startLine": 86,
  "endLine": 87,
  "event": "add"
 },
 {
  "code": "lastUpdate = uint32(block.timestamp);",
  "startLine": 87,
  "endLine": 87,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 89,
  "endLine": 89,
  "event": "add"
 },
 {
  "code": "cumulativeRewardPerToken = rewardPerToken();",
  "startLine": 90,

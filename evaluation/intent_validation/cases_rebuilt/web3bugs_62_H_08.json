 {
  "code": "function updateStreamInternal(address who) internal {\n}",
  "startLine": 78,
  "endLine": 79,
  "event": "add"
 },
 {
  "code": "require(block.timestamp < endStream , \"!stream\");",
  "startLine": 79,
  "endLine": 79,
  "event": "add"
 },
 {
  "code": "TokenStream storage ts = tokensNotYetStreamed[msg.sender];",
  "startLine": 80,

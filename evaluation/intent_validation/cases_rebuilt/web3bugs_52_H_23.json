 {
  "code": "function mintSynth(IERC20 foreignAsset, uint256 nativeDeposit, address _from, address to) external override nonReentrant supportedToken(foreignAsset) returns (uint256 amountSynth) {\n}",
  "startLine": 13,
  "endLine": 14,
  "event": "add"
 },
 {

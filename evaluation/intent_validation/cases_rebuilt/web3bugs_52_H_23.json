 },
 {
  "code": "if (synth == ISynth(_ZERO_ADDRESS)) {\n}",
  "startLine": 18,
  "endLine": 19,
  "event": "add"
 },
 {
  "code": "synth = synthFactory.createSynth(IERC20Extended(address(foreignAsset)));",

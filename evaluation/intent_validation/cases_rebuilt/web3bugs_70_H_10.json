 },
 {
  "code": "function getChainlinkPrice(address asset) public view returns (uint256) {\n}",
  "startLine": 20,
  "endLine": 21,
  "event": "add"
 },
 {
  "code": "IAggregatorV3 oracle = oracles[asset];",
  "startLine": 21,
  "endLine": 21,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 22,
  "endLine": 22,
  "event": "add"
 },
 {
  "code": "(uint80 roundID, int256 price, , , uint80 answeredInRound) = oracle.latestRoundData();",
  "startLine": 23,
  "endLine": 23,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 24,
  "endLine": 24,
  "event": "add"
 },
 {
  "code": "require(answeredInRound >= roundID, \"LBTWAP::getChainlinkPrice: Stale Chainlink Price\");",
  "startLine": 25,
  "endLine": 25,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 26,
  "endLine": 26,
  "event": "add"
 },
 {
  "code": "require(price > 0, \"LBTWAP::getChainlinkPrice: Chainlink Malfunction\");",
  "startLine": 27,
  "endLine": 27,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 28,
  "endLine": 28,
  "event": "add"
 },
 {
  "code": "return uint256(price);",
  "startLine": 29,
  "endLine": 29,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 31,
  "endLine": 31,
  "event": "add"
 },
 {
  "code": "function syncVaderPrice() public override returns (uint256[] memory pastLiquidityWeights, uint256 pastTotalLiquidityWeight) {\n}",
  "startLine": 32,
  "endLine": 33,
  "event": "add"
 },
 {
  "code": "uint256 _totalLiquidityWeight;",
  "startLine": 33,
  "endLine": 33,
  "event": "add"
 },
 {
  "code": "uint256 totalPairs = vaderPairs.length;",
  "startLine": 34,
  "endLine": 34,
  "event": "add"
 },
 {
  "code": "pastLiquidityWeights = new uint256[](totalPairs);",
  "startLine": 35,
  "endLine": 35,
  "event": "add"
 },
 {
  "code": "pastTotalLiquidityWeight = totalLiquidityWeight[uint256(Paths.VADER)];",
  "startLine": 36,
  "endLine": 36,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 37,
  "endLine": 37,
  "event": "add"
 },
 {
  "code": "for (uint256 i; i < totalPairs; ++i) {\n}",
  "startLine": 38,
  "endLine": 39,
  "event": "add"
 },
 {
  "code": "IUniswapV2Pair pair = vaderPairs[i];",
  "startLine": 39,
  "endLine": 39,
  "event": "add"
 },
 {
  "code": "ExchangePair storage pairData = twapData[address(pair)];",
  "startLine": 40,
  "endLine": 40,
  "event": "add"
 },
 {
  "code": "uint256 timeElapsed = block.timestamp - pairData.lastMeasurement;",
  "startLine": 41,
  "endLine": 41,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 42,
  "endLine": 42,
  "event": "add"
 },
 {
  "code": "if (timeElapsed < pairData.updatePeriod) {\n}",
  "startLine": 43,
  "endLine": 44,
  "event": "add"
 },
 {
  "code": "continue;",
  "startLine": 44,
  "endLine": 44,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 46,
  "endLine": 46,
  "event": "add"
 },
 {
  "code": "uint256 pastLiquidityEvaluation = pairData.pastLiquidityEvaluation;",
  "startLine": 47,
  "endLine": 47,
  "event": "add"
 },
 {
  "code": "uint256 currentLiquidityEvaluation = _updateVaderPrice(pair, pairData, timeElapsed);",
  "startLine": 48,
  "endLine": 48,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 49,
  "endLine": 49,
  "event": "add"
 },
 {
  "code": "pastLiquidityWeights[i] = pastLiquidityEvaluation;",
  "startLine": 50,
  "endLine": 50,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 51,
  "endLine": 51,
  "event": "add"
 },
 {
  "code": "pairData.pastLiquidityEvaluation = currentLiquidityEvaluation;",
  "startLine": 52,
  "endLine": 52,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 53,
  "endLine": 53,
  "event": "add"
 },
 {
  "code": "_totalLiquidityWeight += currentLiquidityEvaluation;",
  "startLine": 54,
  "endLine": 54,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 56,
  "endLine": 56,
  "event": "add"
 },
 {
  "code": "totalLiquidityWeight[uint256(Paths.VADER)] = _totalLiquidityWeight;",
  "startLine": 57,
  "endLine": 57,
  "event": "add"
 },
 {

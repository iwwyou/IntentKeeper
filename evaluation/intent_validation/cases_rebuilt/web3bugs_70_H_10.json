 {
  "code": "function _updateVaderPrice(IUniswapV2Pair pair, ExchangePair storage pairData, uint256 timeElapsed) internal returns (uint256 currentLiquidityEvaluation) {\n}",
  "startLine": 60,
  "endLine": 61,
  "event": "add"
 },
 {
  "code": "bool isFirst = pair.token0() == vader;",
  "startLine": 61,
  "endLine": 61,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 62,
  "endLine": 62,
  "event": "add"
 },
 {
  "code": "(uint256 reserve0, uint256 reserve1, ) = pair.getReserves();",
  "startLine": 63,
  "endLine": 63,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 64,
  "endLine": 64,
  "event": "add"
 },
 {
  "code": "(uint256 reserveNative, uint256 reserveForeign) = isFirst ? (reserve0, reserve1) : (reserve1, reserve0);",
  "startLine": 65,
  "endLine": 65,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 66,
  "endLine": 66,
  "event": "add"
 },
 {
  "code": "(uint256 price0Cumulative, uint256 price1Cumulative, uint256 currentMeasurement) = UniswapV2OracleLibrary.currentCumulativePrices(address(pair));",
  "startLine": 67,
  "endLine": 67,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 68,
  "endLine": 68,
  "event": "add"
 },
 {
  "code": "uint256 nativeTokenPriceCumulative = isFirst ? price0Cumulative : price1Cumulative;",
  "startLine": 69,
  "endLine": 69,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 70,
  "endLine": 70,
  "event": "add"
 },
 {
  "code": "unchecked {\n}",
  "startLine": 71,
  "endLine": 72,
  "event": "add"
 },
 {
  "code": "pairData.nativeTokenPriceAverage = FixedPoint.uq112x112(uint224((nativeTokenPriceCumulative - pairData.nativeTokenPriceCumulative) / timeElapsed));",
  "startLine": 72,
  "endLine": 72,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 74,
  "endLine": 74,
  "event": "add"
 },
 {
  "code": "pairData.nativeTokenPriceCumulative = nativeTokenPriceCumulative;",
  "startLine": 75,
  "endLine": 75,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 76,
  "endLine": 76,
  "event": "add"
 },
 {
  "code": "pairData.lastMeasurement = currentMeasurement;",
  "startLine": 77,
  "endLine": 77,
  "event": "add"
 },
 {
  "code": "\n",
  "startLine": 78,
  "endLine": 78,
  "event": "add"
 },
 {
  "code": "currentLiquidityEvaluation = (reserveNative * previousPrices[uint256(Paths.VADER)]) + (reserveForeign * getChainlinkPrice(pairData.foreignAsset));",
  "startLine": 79,
  "endLine": 79,
  "event": "add"
 },

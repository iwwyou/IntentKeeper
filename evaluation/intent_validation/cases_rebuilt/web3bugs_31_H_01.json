 {
  "code": "\n",
  "startLine": 116,
  "endLine": 116,
  "event": "add"
 },
 {
  "code": "uint256 maxCVX = IERC20Upgradeable(CVX).balanceOf(address(this));",
  "startLine": 117,
  "endLine": 117,
  "event": "add"
 },
 {
  "code": "if (cvxToLock > maxCVX) {\n}",
  "startLine": 118,
  "endLine": 119,
  "event": "add"
 },
 {

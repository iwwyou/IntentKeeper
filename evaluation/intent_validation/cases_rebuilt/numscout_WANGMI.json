  "event": "add"
 },
 {
  "code": "require(to != address(0), \"transfer to the zero address\");",
  "startLine": 249,
  "endLine": 249,
  "event": "add"
 },
 {
  "code": "require(amount <= maxTxLimit || isExcludedFromTxLimit[_from] || isExcludedFromTxLimit[to], \"Tx Amount too large\");",
  "startLine": 250,
  "endLine": 250,
  "event": "add"
 },
 {
  "code": "require(balanceOf(to).add(amount) <= maxWalletLimit || isExcludedFromWalletLimit[to], \"Transfer will exceed wallet limit\");",
  "startLine": 251,

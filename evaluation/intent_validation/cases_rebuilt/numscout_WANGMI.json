  "startLine": 266,
  "endLine": 266,
  "event": "add"
 },
 {
  "code": "else if(_from == uniswapV2Pair && to != uniswapV2Pair && block.number < launchBlock + 2 && !isExcludedFromFees[to]) {\n}",
